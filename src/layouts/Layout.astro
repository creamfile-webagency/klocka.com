---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  ogImage?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description,
  ogType = 'website',
  ogImage = '/img/klocka-og.png',
  schema,
  noindex = false,
} = Astro.props;

const siteOrigin = Astro.site?.origin ?? 'https://klocka.com';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? siteOrigin).toString();
const ogImageAbsolute = new URL(ogImage, siteOrigin).toString();
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!doctype html>
<html lang="sv-SE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:site_name" content="Klocka.com" />
    <meta property="og:locale" content="sv_SE" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageAbsolute} />

    <!-- JSON-LD Structured Data -->
    {schemas.map(s => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <!-- DNS hints (non-render-blocking) -->
    {import.meta.env.PROD && (
      <>
        <link rel="preconnect" href="https://www.googletagmanager.com" />
        <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
      </>
    )}
  </head>
  <body>
    <a href="#main" class="skip-link">Hoppa till innehåll</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    {import.meta.env.PROD && (
      <>
        {/* Consent default must run before gtag.js loads — keeps analytics_storage denied until user opts in */}
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('consent', 'default', {
            ad_storage: 'denied',
            analytics_storage: 'denied',
            wait_for_update: 500
          });
        </script>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=G-FXEJ5M904P`}></script>
        <script is:inline>
          gtag('js', new Date());
          gtag('config', 'G-FXEJ5M904P', { linker: { domains: ['klockrummet.se'] } });
        </script>
      </>
    )}
    <CookieConsent />
  </body>
</html>
