---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  ogImage?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description,
  ogType = 'website',
  ogImage = '/img/klocka-og.png',
  schema,
  noindex = false,
} = Astro.props;

const siteOrigin = Astro.site?.origin ?? 'https://klocka.com';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? siteOrigin).toString();
const ogImageAbsolute = new URL(ogImage, siteOrigin).toString();
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!doctype html>
<html lang="sv-SE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <title>{title}</title>
    <meta name="google-adsense-account" content="ca-pub-8364820223873979" />
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="sv-SE" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:site_name" content="Klocka.com" />
    <meta property="og:locale" content="sv_SE" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageAbsolute} />

    <!-- JSON-LD Structured Data -->
    {schemas.map(s => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <!-- Google Analytics consent default — must fire before gtag.js loads (KLC-6).
         gtag/js network fetch is deferred to first interaction or 4 s (KLC-19). -->
    {import.meta.env.PROD && (
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          wait_for_update: 500
        });
        gtag('js', new Date());
        gtag('config', 'G-FXEJ5M904P', { linker: { domains: ['klockrummet.se'] } });
      </script>
    )}
  </head>
  <body>
    <a href="#main" class="skip-link">Hoppa till innehåll</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    {import.meta.env.PROD && (
      <script is:inline>
        (function() {
          var _ga4Loaded = false, _adsLoaded = false;
          var _evts = ['scroll','pointerdown','keydown','touchstart'];

          function _loadGA4() {
            if (_ga4Loaded) return; _ga4Loaded = true;
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=G-FXEJ5M904P';
            document.head.appendChild(s);
          }
          function _loadAds() {
            if (_adsLoaded) return; _adsLoaded = true;
            var s = document.createElement('script');
            s.async = true;
            s.crossOrigin = 'anonymous';
            s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8364820223873979';
            document.head.appendChild(s);
          }
          function _onInteraction() {
            _evts.forEach(function(e) { document.removeEventListener(e, _onInteraction); });
            clearTimeout(_timer);
            _loadGA4(); _loadAds();
          }
          _evts.forEach(function(e) { document.addEventListener(e, _onInteraction, {passive: true}); });
          var _timer = setTimeout(function() { _loadGA4(); _loadAds(); }, 4000);
        })();
      </script>
    )}

  </body>
</html>
