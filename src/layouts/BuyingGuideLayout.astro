---
/**
 * BuyingGuideLayout — template for brand/klockmärken buying-guide pages.
 *
 * Two variants, selected via `variant` prop:
 *   A — Luxury affiliate (Chrono24, WoS, Swedish retailers)
 *   B — Same guide + Klockrummet cross-link as secondary CTA
 *
 * Used by:
 *   Bucket A: Omega, Rolex, Breitling, Patek, Longines, etc.
 *   Bucket B: Casio, Triwa, etc. (Klockrummet stocks or has close alternative)
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '@/layouts/Layout.astro';
import AffiliateDisclosure from '@/components/AffiliateDisclosure.astro';
import KlockrummetCTA from '@/components/KlockrummetCTA.astro';

const heroAssets = import.meta.glob<{ default: ImageMetadata }>('/src/assets/img/*.jpg', { eager: true });

export interface AffiliateCta {
  label: string;
  href: string;
  partner: string;
  rel?: string;
}

export interface BuyingGuideMeta {
  /** Brand or category name, e.g. "Omega" or "Damur" */
  brand: string;
  /** Bucket variant */
  variant: 'A' | 'B';
  /** Page title */
  title: string;
  /** Meta description */
  description: string;
  /** Hero image src */
  heroImage?: string;
  /** Hero image alt */
  heroAlt?: string;
  /** Short brand intro blurb for the hero */
  heroIntro: string;
  /** Price range string, e.g. "10 000 – 150 000 kr" */
  priceRange?: string;
  /** Affiliate CTAs for Bucket A */
  affiliateCtas?: AffiliateCta[];
  /** Klockrummet CTA for Bucket B */
  klockrummetCta?: { href: string; label: string };
  /** JSON-LD Article schema override */
  articleSchema?: Record<string, unknown>;
  /** Breadcrumb parent override — defaults to Klockmärken /klockmarken/ */
  breadcrumbParent?: { href: string; label: string };
  /** ISO 8601 date the article was first published, e.g. "2026-10-23" */
  datePublished?: string;
  /** ISO 8601 date the article was last modified, e.g. "2026-10-23" */
  dateModified?: string;
}

interface Props extends BuyingGuideMeta {}

const {
  brand,
  variant,
  title,
  description,
  heroImage: heroImageProp,
  heroAlt,
  heroIntro,
  priceRange,
  affiliateCtas = [],
  klockrummetCta,
  articleSchema,
  breadcrumbParent = { href: '/klockmarken/', label: 'Klockmärken' },
  datePublished,
  dateModified,
} = Astro.props;

const showDisclosure = affiliateCtas.some(cta => cta.partner === 'klockrummet');

// Derive brand slug from URL so each brand gets its own OG/hero image
// without needing an explicit heroImage prop on every page.
const _slug = Astro.url.pathname.replace(/\/$/, '').split('/').pop() ?? '';
// String path for OG meta tag (served from public/)
const heroImage = heroImageProp ?? (_slug ? `/img/og/${_slug}.jpg` : undefined);
// ImageMetadata for the optimised <Image> hero (served from src/assets/img/)
const heroImgMeta = (heroAssets[`/src/assets/img/${_slug}.jpg`] as { default: ImageMetadata } | undefined)?.default;

const schema: Record<string, unknown>[] = [
  articleSchema ?? {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    url: `https://klocka.com${Astro.url.pathname}`,
    inLanguage: 'sv-SE',
    publisher: {
      '@type': 'Organization',
      name: 'Klocka.com',
      url: 'https://klocka.com',
    },
    ...(datePublished ? { datePublished } : {}),
    ...(dateModified ? { dateModified } : {}),
    author: {
      '@type': 'Organization',
      name: 'Klocka.com',
      url: 'https://klocka.com',
    },
    ...(heroImage ? { image: `https://klocka.com${heroImage}` } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Hem',
        item: 'https://klocka.com/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: breadcrumbParent.label,
        item: `https://klocka.com${breadcrumbParent.href}`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: brand,
        item: `https://klocka.com${Astro.url.pathname}`,
      },
    ],
  },
];
---

<Layout {title} {description} ogType="article" schema={schema} ogImage={heroImage}>
  <div class="guide-page">

    <!-- Hero -->
    <header class="guide-hero">
      <div class="guide-hero-inner">
        <nav class="breadcrumb" aria-label="Brödsmulor">
          <a href="/">Hem</a>
          <span aria-hidden="true">›</span>
          <a href={breadcrumbParent.href}>{breadcrumbParent.label}</a>
          <span aria-hidden="true">›</span>
          <span aria-current="page">{brand}</span>
        </nav>
        <h1>{title.split('|')[0]?.trim() ?? title}</h1>
        <p class="guide-intro">{heroIntro}</p>
        {priceRange && (
          <p class="price-badge">
            <span class="price-label">Prisintervall</span>
            <span class="price-value">{priceRange}</span>
          </p>
        )}
        {dateModified && (
          <p class="updated-date">
            <span class="sr-only">Senast uppdaterad</span>
            <time datetime={dateModified}>
              Senast uppdaterad {new Date(dateModified).toLocaleDateString('sv-SE', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          </p>
        )}
      </div>
      {heroImgMeta && (
        <div class="guide-hero-img">
          <Image
            src={heroImgMeta}
            alt={heroAlt ?? `${brand} klockor`}
            widths={[420, 840]}
            sizes="(min-width: 768px) 420px, 100vw"
            fetchpriority="high"
            loading="eager"
          />
        </div>
      )}
    </header>

    <!-- Affiliate CTAs: Bucket A -->
    {showDisclosure && <AffiliateDisclosure />}
    {variant === 'A' && affiliateCtas.length > 0 && (
      <section class="cta-section" aria-label="Köpguide">
        <div class="affiliate-cta">
          <div class="affiliate-label">Köp {brand} i Sverige</div>
          <div class="cta-grid">
            {affiliateCtas.map(({ label, href, partner, rel }) => (
              <a
                href={href}
                class="btn btn-primary"
                target="_blank"
                rel={rel ?? 'noopener nofollow'}
                aria-label={`${label} — öppnas i ny flik`}
                data-partner={partner}
              >
                {label}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
                </svg>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}


    <!-- Article body -->
    <article class="guide-body prose">
      <slot />
    </article>

    <!-- Bottom CTA (repeat) -->
    {variant === 'A' && affiliateCtas.length > 0 && (
      <section class="cta-section cta-section--bottom" aria-label="Köplänkar">
        <div class="affiliate-cta">
          <div class="affiliate-label">Hitta din {brand}</div>
          <div class="cta-grid">
            {affiliateCtas.map(({ label, href, partner, rel }) => (
              <a href={href} class="btn btn-primary" target="_blank" rel={rel ?? 'noopener nofollow'} data-partner={partner}>
                {label}
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </div>
</Layout>

<script>
document.querySelectorAll('.cta-section a[data-partner]').forEach(link => {
  link.addEventListener('click', () => {
    if (typeof gtag !== 'undefined') {
      gtag('event', 'outbound_affiliate_click', { partner: (link as HTMLAnchorElement).dataset.partner });
    }
  });
});
</script>

<style>
  .guide-page {
    max-width: var(--max-w-content);
    margin-inline: auto;
    padding: var(--space-8) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* Hero */
  .guide-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: start;
  }
  @media (min-width: 768px) {
    .guide-hero { grid-template-columns: 1fr auto; }
    .guide-hero-img { width: 320px; }
  }
  @media (min-width: 1024px) {
    .guide-hero-img { width: 420px; }
  }

  .guide-hero-img img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    object-fit: cover;
    box-shadow: var(--shadow-md);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    margin-bottom: var(--space-4);
  }
  .breadcrumb a { color: var(--color-ink-muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-accent); }

  .guide-hero-inner h1 {
    font-size: var(--text-3xl);
    font-weight: 700;
    margin: 0 0 var(--space-4);
    letter-spacing: -0.02em;
  }
  @media (min-width: 640px) { .guide-hero-inner h1 { font-size: var(--text-4xl); } }

  .guide-intro {
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-4);
    max-width: var(--max-w-prose);
  }

  .price-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-2) var(--space-4);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    font-size: var(--text-sm);
  }
  .price-label { color: var(--color-ink-muted); font-weight: 500; }
  .price-value { font-weight: 700; }

  .updated-date {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    margin: var(--space-2) 0 0;
  }

  /* CTA */
  .cta-section { max-width: var(--max-w-prose); }
  .cta-section--bottom { margin-top: var(--space-4); }
  .cta-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  /* Guide body */
  .guide-body { max-width: var(--max-w-prose); }
</style>
