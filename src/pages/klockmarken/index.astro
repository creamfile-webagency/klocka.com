---
import Layout from '@/layouts/Layout.astro';

// Bucket A: luxury buying-guide pages with affiliate CTAs
const bucketA = [
  { slug: 'omega', label: 'Omega', desc: 'Schweiziskt prestige — Seamaster, Speedmaster, De Ville', priceRange: '15 000 – 200 000 kr' },
  { slug: 'rolex', label: 'Rolex', desc: 'Det mest igenkändbara klocknamnet — Submariner, Datejust, Daytona', priceRange: '60 000 – 500 000+ kr' },
  { slug: 'breitling', label: 'Breitling', desc: 'Aviation och sport — Navitimer, Superocean, Chronomat', priceRange: '25 000 – 150 000 kr' },
  { slug: 'longines', label: 'Longines', desc: 'Elegans och sportighet — Master Collection, HydroConquest', priceRange: '8 000 – 40 000 kr' },
  { slug: 'tag-heuer', label: 'TAG Heuer', desc: 'Motorsport och präcision — Carrera, Aquaracer, Monaco', priceRange: '10 000 – 60 000 kr' },
  { slug: 'seiko', label: 'Seiko', desc: 'Japansk kvalitet från budgetklassen till Grand Seiko', priceRange: '2 000 – 80 000 kr' },
];

// Bucket B: buying-guide + Klockrummet cross-link
const bucketB = [
  { slug: 'casio', label: 'Casio', desc: 'G-Shock, Edifice, databank — hållbarhet och teknik', priceRange: '500 – 15 000 kr' },
  { slug: 'daniel-wellington', label: 'Daniel Wellington', desc: 'Skandinavisk minimalism — tidlösa klädklockor', priceRange: '800 – 3 000 kr' },
  { slug: 'triwa', label: 'Triwa', desc: 'Stockholmsdesign med hållbarhetstänk', priceRange: '1 000 – 4 000 kr' },
];
---

<Layout
  title="Klockmärken — Köpguider för klockor | Klocka.com"
  description="Köpguider för populära klockmärken. Omega, Rolex, Breitling, Longines, Casio och mer — historia, modeller och var du köper i Sverige."
>
  <div class="page-index">
    <header class="index-header">
      <h1>Klockmärken</h1>
      <p>Svenska köpguider för populära klockmärken — historia, modeller, prisintervall och var du hittar dem i Sverige.</p>
    </header>

    <section>
      <h2 class="bucket-heading">Lyxklockor</h2>
      <ul class="brands-grid" role="list">
        {bucketA.map(({ slug, label, desc, priceRange }) => (
          <li>
            <a href={`/klockmarken/${slug}/`} class="brand-card">
              <span class="brand-name">{label}</span>
              <span class="brand-desc">{desc}</span>
              <span class="brand-price">{priceRange}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="bucket-heading">Populära märken</h2>
      <ul class="brands-grid" role="list">
        {bucketB.map(({ slug, label, desc, priceRange }) => (
          <li>
            <a href={`/klockmarken/${slug}/`} class="brand-card">
              <span class="brand-name">{label}</span>
              <span class="brand-desc">{desc}</span>
              <span class="brand-price">{priceRange}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Layout>

<style>
  .page-index {
    max-width: var(--max-w-content);
    margin-inline: auto;
    padding: var(--space-8) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }
  .index-header h1 {
    font-size: var(--text-3xl);
    font-weight: 700;
    margin: 0 0 var(--space-3);
    letter-spacing: -0.02em;
  }
  .index-header p { font-size: var(--text-lg); color: var(--color-ink-muted); margin: 0; }
  .bucket-heading {
    font-size: var(--text-xl);
    font-weight: 700;
    margin: 0 0 var(--space-5);
  }
  .brands-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .brand-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--color-ink);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition-fast), border-color var(--transition-fast);
    height: 100%;
  }
  .brand-card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--color-accent);
  }
  .brand-name { font-size: var(--text-lg); font-weight: 700; }
  .brand-desc { font-size: var(--text-sm); color: var(--color-ink-muted); }
  .brand-price {
    margin-top: auto;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-ink-muted);
    padding: var(--space-1) var(--space-2);
    background: var(--color-surface-2);
    border-radius: var(--radius-sm);
    width: fit-content;
  }
</style>
