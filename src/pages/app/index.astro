---
import Layout from '@/layouts/Layout.astro';

const tools = [
  { href: '/schackklocka/', label: 'Schackklocka', desc: 'Online schackklocka med Fischer & Bronstein tillägg. Klicka på din timer för att byta spelare.', icon: '♟', clicks: 30 },
  { href: '/stoppur/', label: 'Stoppur', desc: 'Precisionsstoppur med varvtider. Starta med ett knapptryck.', icon: '⏱', clicks: 26 },
  { href: '/presentation/', label: 'Presentationsklocka', desc: 'Håll koll på din tid under föreläsningar och presentationer.', icon: '🎤', clicks: 23 },
  { href: '/interval/', label: 'Intervallklocka', desc: 'Timerfunktion för träningsintervaller och pauscykler.', icon: '🔔', clicks: 22 },
  { href: '/pomodoro/', label: 'Pomodoroklocka', desc: 'Pomodoro-tekniken: 25 minuter fokus, 5 minuter paus.', icon: '🍅', clicks: 21 },
  { href: '/nedrakning/', label: 'Nedräkningstimer', desc: 'Nedräkningstimer med larmfunktion — sätt din tid och kör.', icon: '⏳', clicks: 8 },
  { href: '/aggklocka/', label: 'Äggklocka', desc: 'Snabb köksTimer för perfekta ägg — och allt annat i köket.', icon: '🥚', clicks: 4 },
];
---

<Layout
  title="Appar — Gratis timers, stoppur och tidappar online | Klocka.com"
  description="Sju gratis tidappar online — schackklocka, stoppur, nedräkningstimer, Pomodoro-timer, intervalltimer, presentationstimer och äggklocka. Inga installationer, inga konton — bara öppna och kör i webbläsaren."
>
  <div class="page-index">
    <header class="index-header">
      <h1>Appar</h1>
      <p class="index-lead">
        Sju kostnadsfria <strong>tidappar</strong> — alla våra <strong>timers</strong> och
        <strong>time tools</strong> körs direkt i webbläsaren. Ingen nedladdning, inget konto,
        ingen reklam i själva appen. Välj en app nedan och kör direkt.
      </p>
    </header>

    <ul class="tools-list" role="list">
      {tools.map(({ href, label, desc, icon }) => (
        <li>
          <a href={href} class="tool-row">
            <span class="tool-row-icon" aria-hidden="true">{icon}</span>
            <span class="tool-row-body">
              <span class="tool-row-name">{label}</span>
              <span class="tool-row-desc">{desc}</span>
            </span>
            <svg class="tool-row-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M9 18l6-6-6-6"/>
            </svg>
          </a>
        </li>
      ))}
    </ul>

    <section class="page-prose prose">
      <h2>Webbappar för tid och tidtagning</h2>
      <p>
        Alla appar på Klocka.com är byggda som <strong>progressive web apps</strong> —
        snabba JavaScript-timers med millisekundsprecision via <code>performance.now()</code>.
        Inställningar sparas lokalt i webbläsaren via <code>localStorage</code>, så nästa
        gång du öppnar en app hittar du den exakt som du lämnade den. Inget moln, ingen
        spårning av personuppgifter.
      </p>

      <h2>Vilken timer passar dig?</h2>
      <ul>
        <li>
          <strong>Schackklocka</strong> — för schackpartier med tidsbegränsning. Stöder
          både Fischer- och Bronstein-tillägg.
        </li>
        <li>
          <strong>Stoppur</strong> — för tidtagning med varvtider. Springer du, lagar mat
          eller mäter responstid?
        </li>
        <li>
          <strong>Nedräkningstimer</strong> — sätt en tid, få ett larm. Klassisk
          kitchen timer i webbläsaren.
        </li>
        <li>
          <strong>Pomodoro-timer</strong> — för Pomodoro-tekniken: 25 minuters fokus
          följt av 5 minuters paus.
        </li>
        <li>
          <strong>Intervalltimer</strong> — för HIIT, Tabata och annan intervallträning
          med konfigurerbara arbets- och vilopass.
        </li>
        <li>
          <strong>Presentationstimer</strong> — för föreläsare som vill hålla koll på
          tid på scen utan att titta på telefonen.
        </li>
        <li>
          <strong>Äggklocka</strong> — kökstimer med preset för löskokt, mellankokt och
          hårdkokt ägg.
        </li>
      </ul>

      <h2>Varför öppna en webbapp istället för att ladda ner?</h2>
      <p>
        Mobilappar tar plats, kräver uppdateringar och spårar dig. En timer i
        webbläsaren startar på en sekund, fungerar i bakgrunden (många stöder
        Wake Lock API), och uppdateras automatiskt när vi förbättrar dem. Bookmarka
        sidan på din hemskärm så får du en "app"-genväg utan att installera något.
      </p>

      <h2>Alla appar är gratis</h2>
      <p>
        Klocka.com finansieras via diskreta AdSense-annonser bredvid (inte i) appen
        och affilieringslänkar i våra köpguider för klockor. Se vår
        <a href="/redaktionell-policy/">redaktionella policy</a>. Apparna i sig är
        helt gratis — utan inloggning, utan begränsningar, utan abonnemang.
      </p>
    </section>
  </div>
</Layout>

<style>
  .page-index {
    max-width: var(--max-w-content);
    margin-inline: auto;
    padding: var(--space-8) var(--space-4);
  }
  .index-header { margin-bottom: var(--space-8); }
  .index-header h1 {
    font-size: var(--text-3xl);
    font-weight: 700;
    margin: 0 0 var(--space-3);
    letter-spacing: -0.02em;
  }
  .index-lead { font-size: var(--text-lg); color: var(--color-ink-muted); margin: 0; max-width: 64ch; }
  .index-lead strong { color: var(--color-ink); font-weight: 600; }

  .page-prose {
    max-width: 64ch;
    margin-top: var(--space-10);
  }
  .page-prose h2 {
    font-size: var(--text-xl);
    font-weight: 600;
    margin: var(--space-6) 0 var(--space-3);
  }
  .page-prose p, .page-prose ul { margin: 0 0 var(--space-3); line-height: 1.65; }
  .page-prose ul { padding-inline-start: var(--space-5); }
  .page-prose a { color: var(--color-accent); }
  .page-prose a:hover { text-decoration: underline; }
  .page-prose code {
    font-family: ui-monospace, SFMono-Regular, monospace;
    background: var(--color-surface-2);
    padding: 0 0.3em;
    border-radius: var(--radius-sm);
    font-size: 0.92em;
  }

  .tools-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .tool-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--color-ink);
    transition: box-shadow var(--transition-fast), border-color var(--transition-fast);
  }
  .tool-row:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
  }
  .tool-row-icon { font-size: var(--text-2xl); flex-shrink: 0; }
  .tool-row-body { flex: 1; display: flex; flex-direction: column; gap: var(--space-1); }
  .tool-row-name { font-weight: 600; font-size: var(--text-base); }
  .tool-row-desc { font-size: var(--text-sm); color: var(--color-ink-muted); }
  .tool-row-arrow { flex-shrink: 0; color: var(--color-ink-muted); }
</style>
