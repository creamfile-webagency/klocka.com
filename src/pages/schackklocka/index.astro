---
import Layout from '@/layouts/Layout.astro';

const title = 'Schackklocka online — Fischer & Bronstein | Klocka.com';
const description = 'Gratis schackklocka online med Fischer och Bronstein tillägg. Klicka på din timer för att byta spelare. Fungerar på mobil och dator.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Schackklocka',
    url: 'https://klocka.com/schackklocka/',
    applicationCategory: 'GameApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'SEK' },
    description,
    inLanguage: 'sv-SE',
    provider: {
      '@type': 'Organization',
      name: 'Klocka.com',
      url: 'https://klocka.com',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'Så använder du schackklockan',
    step: [
      { '@type': 'HowToStep', position: 1, name: 'Ange starttid', text: 'Ange hur många minuter varje spelare börjar med.' },
      { '@type': 'HowToStep', position: 2, name: 'Välj tillägg', text: 'Välj Fischer, Bronstein eller inget tillägg och ange antal sekunder.' },
      { '@type': 'HowToStep', position: 3, name: 'Starta', text: 'Tryck på Starta eller Enter. Klockan börjar räkna ner för Spelare 1.' },
      { '@type': 'HowToStep', position: 4, name: 'Byt spelare', text: 'Klicka på din timer (eller tryck Space) efter varje drag för att växla.' },
    ],
  },
];
---

<Layout {title} {description} ogType="website" schema={schema}>
  <div class="page-tool">
    <div class="tool-header">
      <h1>Schackklocka online</h1>
      <p class="tool-intro">Starta ett schackparti direkt — välj tid per spelare, Fischer- eller Bronstein-tillägg och tryck start. Klockan växlar automatiskt när en spelare trycker på sin knapp.</p>
    </div>

    <!-- The chess clock island -->
    <div class="tool-card" id="chess-clock" role="application" aria-label="Schackklocka">

      <!-- Player tiles -->
      <div class="players-row">
        <button
          id="player1"
          class="player-tile active"
          aria-label="Spelare 1 — klicka för att avsluta ditt drag"
          aria-pressed="true"
        >
          <span class="player-label">Spelare 1</span>
          <span class="clock-display" id="time1" aria-live="off">10:00</span>
        </button>

        <button
          id="player2"
          class="player-tile"
          aria-label="Spelare 2 — klicka för att avsluta ditt drag"
          aria-pressed="false"
        >
          <span class="player-label">Spelare 2</span>
          <span class="clock-display" id="time2" aria-live="off">10:00</span>
        </button>
      </div>

      <!-- Controls -->
      <div class="controls-row">
        <button id="startPauseBtn" class="btn btn-primary" aria-label="Starta klockan">Starta</button>
        <button id="resetBtn" class="btn btn-ghost" aria-label="Återställ klockan">Återställ</button>
      </div>

      <!-- Settings -->
      <details class="settings-panel" id="settings-panel">
        <summary class="settings-toggle">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
          </svg>
          Inställningar
        </summary>
        <div class="settings-grid">
          <label class="setting-field">
            <span class="setting-label">Starttid (min)</span>
            <input
              type="number"
              id="timeControl"
              min="1"
              max="180"
              value="10"
              class="setting-input"
              aria-label="Starttid per spelare i minuter"
            />
          </label>
          <label class="setting-field">
            <span class="setting-label">Tillägg (sek)</span>
            <input
              type="number"
              id="incrementControl"
              min="0"
              max="60"
              value="5"
              class="setting-input"
              aria-label="Tillägg i sekunder per drag"
            />
          </label>
          <label class="setting-field">
            <span class="setting-label">Typ av tillägg</span>
            <select id="incrementType" class="setting-input" aria-label="Typ av tidsfellägg">
              <option value="fischer" selected>Fischer</option>
              <option value="bronstein">Bronstein</option>
              <option value="none">Inget</option>
            </select>
          </label>
        </div>
      </details>

      <!-- Keyboard shortcuts hint -->
      <p class="shortcuts-hint">
        <kbd>Space</kbd> byt spelare &nbsp;·&nbsp;
        <kbd>Enter</kbd> starta/pausa &nbsp;·&nbsp;
        <kbd>Esc</kbd> återställ
      </p>
    </div>

    <!-- Status message (ARIA live region) -->
    <p id="status-msg" class="sr-only" aria-live="assertive" aria-atomic="true"></p>

    <!-- Prose + desktop sidebar -->
    <div class="content-with-sidebar">
      <article class="tool-content prose">
        <h2>Spela schack med klocka online</h2>
      <p>
        En schackklocka är ett viktigt verktyg i tidsbegränsade schackpartier. Den hanterar varje spelares
        tilldelade tid och säkerställer rättvist och spännande spel. Klocka.coms schackklocka har två timers
        — en för varje spelare — som räknar ner oberoende och växlar när en spelare avslutar sitt drag.
      </p>

      <h3>Grundläggande funktion</h3>
      <ul>
        <li>Varje spelare börjar med samma starttid (standardinställning: 10 minuter).</li>
        <li>När det är en spelares tur räknar deras timer ned.</li>
        <li>Klicka på din timer (eller tryck <kbd>Space</kbd>) efter varje drag för att byta spelare.</li>
        <li>Spelet fortsätter tills en spelares tid tar slut — förlust på tid.</li>
      </ul>

      <h3>Modeller för tilläggstid</h3>
      <h4>1. Fischer-tillägg</h4>
      <p>
        Uppkallat efter Bobby Fischer. Ett fast tillägg (t.ex. 5 sekunder) läggs till <strong>i början av varje
        spelares tur</strong>. Snabba drag kan öka den totala tillgängliga tiden.
        Standard i de flesta officiella turneringar i dag.
      </p>
      <h4>2. Bronstein-tillägg (fördröjning)</h4>
      <p>
        Uppkallat efter David Bronstein. Tillägget läggs till <strong>efter att draget är klart</strong>,
        men maximalt den tid spelaren faktiskt förbrukade. Spelarens totala tid kan aldrig öka utöver
        starttiden — till skillnad från Fischer-tillägget.
      </p>

      <h3>Kortkommandon</h3>
      <ul>
        <li><kbd>Space</kbd> — byt aktiv spelare (avslutar ditt drag)</li>
        <li><kbd>Enter</kbd> — starta eller pausa</li>
        <li><kbd>Esc</kbd> — återställ klockan</li>
      </ul>

      <h3>Visuella och ljudmässiga indikationer</h3>
      <ul>
        <li>Den aktiva spelarens ruta markeras i grönt.</li>
        <li>Under 30 sekunder kvar blinkar timern i rött.</li>
        <li>Ett kort pip-ljud spelas när timern passerar 30-sekundergränsen.</li>
      </ul>

      <p>
        Redo att spela ett riktigt parti?
        <a href="https://coolaspel.se/schack/" target="_blank" rel="noopener">Spela schack online på Coolaspel</a>
        — ett gratis schackspel direkt i webbläsaren.
      </p>
      </article>

      <!-- Slot 2: desktop sidebar (160×600) — hidden on mobile, visible at ≥1024px -->
      <!-- OWNER ACTION: Replace REPLACE_WITH_SLOT_ID_2 with real slot ID from AdSense dashboard -->
      <div class="ad-slot ad-slot--sidebar" aria-hidden="true">
        <ins class="adsbygoogle"
             style="display:block"
             data-ad-client="ca-pub-8364820223873979"
             data-ad-slot="REPLACE_WITH_SLOT_ID_2"
             data-ad-format="auto"
             data-full-width-responsive="false"></ins>
        <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
      </div>
    </div>

    <!-- Slot 1: below-fold rectangle — reserved space prevents CLS -->
    <!-- OWNER ACTION: Replace REPLACE_WITH_SLOT_ID_1 with real slot ID from AdSense dashboard -->
    <div class="ad-slot ad-slot--rectangle" aria-hidden="true">
      <ins class="adsbygoogle"
           style="display:block"
           data-ad-client="ca-pub-8364820223873979"
           data-ad-slot="REPLACE_WITH_SLOT_ID_1"
           data-ad-format="rectangle"
           data-full-width-responsive="true"></ins>
      <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
    </div>
  </div>
</Layout>

<style>
  .page-tool {
    max-width: var(--max-w-content);
    margin-inline: auto;
    padding: var(--space-8) var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
  }
  .tool-header {
    text-align: center;
    max-width: 44rem;
  }
  .tool-header h1 {
    font-size: var(--text-3xl);
    font-weight: 700;
    margin: 0 0 var(--space-3);
    color: var(--color-ink);
    letter-spacing: -0.02em;
  }
  @media (min-width: 640px) { .tool-header h1 { font-size: var(--text-4xl); } }
  .tool-intro {
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
    margin: 0;
  }

  .players-row {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }
  @media (max-width: 480px) {
    .players-row { flex-direction: column; }
  }

  .controls-row {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .controls-row .btn { flex: 1; max-width: 140px; }

  /* Settings */
  .settings-panel {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-4);
  }
  .settings-toggle {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    cursor: pointer;
    list-style: none;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink-muted);
    padding: var(--space-1) 0;
    user-select: none;
  }
  .settings-toggle:hover { color: var(--color-ink); }
  .settings-toggle::-webkit-details-marker { display: none; }
  .settings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: var(--space-4);
    padding-top: var(--space-4);
  }
  .setting-field { display: flex; flex-direction: column; gap: var(--space-1); }
  .setting-label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .setting-input {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-ink);
    background: var(--color-surface);
    min-height: 44px;
    width: 100%;
  }
  .setting-input:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
    border-color: var(--color-accent);
  }

  .shortcuts-hint {
    text-align: center;
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    margin: var(--space-4) 0 0;
  }
  kbd {
    display: inline-block;
    padding: 2px 6px;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .content-with-sidebar {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  @media (min-width: 1024px) {
    .content-with-sidebar {
      flex-direction: row;
      align-items: flex-start;
      justify-content: center;
      gap: var(--space-8);
    }
    .content-with-sidebar .tool-content {
      flex: 1;
      min-width: 0;
      max-width: var(--max-w-prose);
    }
  }

  .tool-content {
    width: 100%;
    max-width: var(--max-w-prose);
  }
  .tool-content h2:first-child { margin-top: 0; }

  /* Ad slots — reserved dimensions prevent CLS */
  .ad-slot { overflow: hidden; }
  .ad-slot--rectangle {
    min-height: 250px;
    min-width: 300px;
  }
  .ad-slot--sidebar {
    width: 160px;
    min-height: 600px;
    flex-shrink: 0;
    display: none;
  }
  @media (min-width: 1024px) {
    .ad-slot--sidebar {
      display: block;
      position: sticky;
      top: var(--space-4);
    }
  }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0);
    white-space: nowrap; border-width: 0;
  }
</style>

<script>
  // Chess clock island — vanilla TS, no framework
  (function () {
    const p1El = document.getElementById('player1') as HTMLButtonElement | null;
    const p2El = document.getElementById('player2') as HTMLButtonElement | null;
    const time1El = document.getElementById('time1');
    const time2El = document.getElementById('time2');
    const startPauseBtn = document.getElementById('startPauseBtn') as HTMLButtonElement | null;
    const resetBtn = document.getElementById('resetBtn') as HTMLButtonElement | null;
    const timeControl = document.getElementById('timeControl') as HTMLInputElement | null;
    const incrementControl = document.getElementById('incrementControl') as HTMLInputElement | null;
    const incrementTypeSelect = document.getElementById('incrementType') as HTMLSelectElement | null;
    const statusMsg = document.getElementById('status-msg');

    if (!p1El || !p2El || !time1El || !time2El || !startPauseBtn || !resetBtn || !timeControl || !incrementControl || !incrementTypeSelect) return;

    // ── Audio: synthesised beep via Web Audio (no file dependency) ──
    function beep() {
      try {
        const AudioCtx = window.AudioContext ?? (window as typeof window & { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
        if (!AudioCtx) return;
        const ctx = new AudioCtx();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.connect(gain); gain.connect(ctx.destination);
        osc.type = 'sine'; osc.frequency.value = 880;
        gain.gain.setValueAtTime(0.3, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.25);
        osc.start(); osc.stop(ctx.currentTime + 0.25);
      } catch { /* ignore */ }
    }

    // ── State ──
    type Player = 'p1' | 'p2';
    let timers: Record<Player, number> = { p1: 600, p2: 600 };
    let activePlayer: Player = 'p1';
    let running = false;
    let rafId: number | null = null;
    let lastTs: number | null = null;
    let moveStartTs: number | null = null;
    let lowTimeBeepPlayed: Record<Player, boolean> = { p1: false, p2: false };

    function getSettings() {
      return {
        initialSeconds: Math.max(1, parseInt(timeControl!.value ?? '10', 10)) * 60,
        increment: Math.max(0, parseInt(incrementControl!.value ?? '0', 10)),
        incType: (incrementTypeSelect!.value ?? 'none') as 'fischer' | 'bronstein' | 'none',
      };
    }

    function formatTime(s: number): string {
      const m = Math.floor(s / 60);
      const ss = s % 60;
      return `${m}:${ss < 10 ? '0' : ''}${ss}`;
    }

    function updateDisplay() {
      time1El!.textContent = formatTime(timers.p1);
      time2El!.textContent = formatTime(timers.p2);

      const lowP1 = timers.p1 <= 30 && timers.p1 > 0;
      const lowP2 = timers.p2 <= 30 && timers.p2 > 0;

      time1El!.className = `clock-display${timers.p1 === 0 ? ' timeout' : lowP1 ? ' low-time' : ''}`;
      time2El!.className = `clock-display${timers.p2 === 0 ? ' timeout' : lowP2 ? ' low-time' : ''}`;
      p1El!.classList.toggle('low-time', lowP1);
      p2El!.classList.toggle('low-time', lowP2);
    }

    function updateActiveUI() {
      const isP1 = activePlayer === 'p1';
      p1El!.classList.toggle('active', isP1);
      p1El!.setAttribute('aria-pressed', String(isP1));
      p2El!.classList.toggle('active', !isP1);
      p2El!.setAttribute('aria-pressed', String(!isP1));
    }

    function stopLoop() {
      running = false;
      if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; }
      lastTs = null;
    }

    function announce(msg: string) {
      if (statusMsg) { statusMsg.textContent = ''; requestAnimationFrame(() => { statusMsg.textContent = msg; }); }
    }

    function loop(ts: number) {
      if (!running) return;
      if (lastTs === null) { lastTs = ts; }
      const elapsed = Math.floor((ts - lastTs) / 1000);

      if (elapsed >= 1) {
        timers[activePlayer] -= elapsed;
        if (timers[activePlayer] < 0) timers[activePlayer] = 0;
        lastTs = ts - ((ts - lastTs) % 1000);

        // Low-time beep
        if (timers[activePlayer] <= 30 && !lowTimeBeepPlayed[activePlayer]) {
          beep();
          lowTimeBeepPlayed[activePlayer] = true;
        }

        updateDisplay();

        if (timers[activePlayer] <= 0) {
          stopLoop();
          const label = activePlayer === 'p1' ? 'Spelare 1' : 'Spelare 2';
          announce(`${label} har slut på tid!`);
          startPauseBtn!.textContent = 'Starta';
          p1El!.setAttribute('disabled', '');
          p2El!.setAttribute('disabled', '');
          p1El!.classList.add('timeout');
          p2El!.classList.add('timeout');
          return;
        }
      }

      rafId = requestAnimationFrame(loop);
    }

    function startClock() {
      if (running) return;
      const { incType, increment } = getSettings();
      running = true;
      moveStartTs = performance.now();
      if (incType === 'fischer') { timers[activePlayer] += increment; }
      updateDisplay();
      updateActiveUI();
      startPauseBtn!.textContent = 'Pausa';
      rafId = requestAnimationFrame(loop);
    }

    function pauseClock() {
      stopLoop();
      startPauseBtn!.textContent = 'Starta';
    }

    function switchPlayer() {
      if (!running) return;
      const now = performance.now();
      const { incType, increment } = getSettings();
      const prev = activePlayer;

      // Flush remaining ms for this tick
      if (lastTs !== null) {
        const remainMs = now - lastTs;
        const secs = Math.floor(remainMs / 1000);
        if (secs > 0) {
          timers[prev] -= secs;
          if (timers[prev] < 0) timers[prev] = 0;
        }
      }

      // Bronstein: add back min(time-spent, increment)
      if (incType === 'bronstein' && moveStartTs !== null) {
        const spentSec = Math.floor((now - moveStartTs) / 1000);
        timers[prev] += Math.min(spentSec, increment);
      }

      // Check if prev ran out exactly on switch
      if (timers[prev] <= 0) {
        stopLoop();
        const label = prev === 'p1' ? 'Spelare 1' : 'Spelare 2';
        announce(`${label} har slut på tid!`);
        startPauseBtn!.textContent = 'Starta';
        return;
      }

      // Switch
      activePlayer = prev === 'p1' ? 'p2' : 'p1';
      lastTs = now;
      moveStartTs = now;
      lowTimeBeepPlayed[activePlayer] = false;

      if (incType === 'fischer') { timers[activePlayer] += increment; }

      updateDisplay();
      updateActiveUI();
    }

    function resetClock() {
      stopLoop();
      const { initialSeconds } = getSettings();
      timers = { p1: initialSeconds, p2: initialSeconds };
      activePlayer = 'p1';
      lowTimeBeepPlayed = { p1: false, p2: false };
      moveStartTs = null;
      startPauseBtn!.textContent = 'Starta';
      p1El!.removeAttribute('disabled');
      p2El!.removeAttribute('disabled');
      p1El!.classList.remove('timeout');
      p2El!.classList.remove('timeout');
      updateDisplay();
      updateActiveUI();
      announce('');
    }

    // ── Event listeners ──
    startPauseBtn.addEventListener('click', () => running ? pauseClock() : startClock());
    resetBtn.addEventListener('click', resetClock);

    p1El.addEventListener('click', () => {
      if (running && activePlayer === 'p1') switchPlayer();
      else if (!running && !p1El.hasAttribute('disabled')) startClock();
    });
    p2El.addEventListener('click', () => {
      if (running && activePlayer === 'p2') switchPlayer();
      else if (!running && !p2El.hasAttribute('disabled')) startClock();
    });

    // Touch: prevent double-fire on mobile (touchend triggers both touchend and click)
    let lastTouch = 0;
    function handleTouchSwitch(e: TouchEvent) {
      e.preventDefault();
      const now = Date.now();
      if (now - lastTouch < 300) return;
      lastTouch = now;
      const btn = e.currentTarget as HTMLButtonElement;
      const which = btn.id === 'player1' ? 'p1' : 'p2';
      if (running && activePlayer === which) switchPlayer();
      else if (!running) startClock();
    }
    p1El.addEventListener('touchend', handleTouchSwitch, { passive: false });
    p2El.addEventListener('touchend', handleTouchSwitch, { passive: false });

    document.addEventListener('keydown', (e) => {
      const tag = (document.activeElement as HTMLElement)?.tagName;
      if (tag === 'INPUT' || tag === 'SELECT' || tag === 'TEXTAREA') return;
      if (e.code === 'Space') { e.preventDefault(); if (running) switchPlayer(); }
      else if (e.code === 'Enter') { e.preventDefault(); running ? pauseClock() : startClock(); }
      else if (e.code === 'Escape') { e.preventDefault(); resetClock(); }
    });

    timeControl.addEventListener('change', resetClock);
    incrementControl.addEventListener('change', resetClock);
    incrementTypeSelect.addEventListener('change', resetClock);

    // Init
    resetClock();
  })();
</script>
