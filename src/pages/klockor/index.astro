---
import Layout from '@/layouts/Layout.astro';

const categories = [
  {
    label: 'Herrur',
    desc: 'Klassiska och sportiga herrur i alla prisklasser — från Seiko under 2 000 kr till Omega och Rolex.',
    slug: 'herrur',
    img: '/img/og-herrur.jpg',
    imgAlt: 'Herrklockor — köpguide',
  },
  {
    label: 'Damur',
    desc: 'Eleganta och moderna damklockor. Daniel Wellington, Longines, Omega och mer — i alla prisklasser.',
    slug: 'damur',
    img: '/img/og-damklockor.jpg',
    imgAlt: 'Damklockor — köpguide',
  },
  {
    label: 'Sportwatch',
    desc: 'GPS-klockor för löpning, triathlon och äventyr. Garmin, Polar, Suunto och Coros jämförda.',
    slug: 'sportwatch',
    img: '/img/og-sportwatch.jpg',
    imgAlt: 'Sportwatch — GPS-klockor för träning',
  },
  {
    label: 'Smartwatch',
    desc: 'Smarta klockor med app-stöd, hälsofunktioner och notiser. Apple Watch vs Samsung vs Garmin.',
    slug: 'smartwatch',
    img: '/img/og-smartwatch.jpg',
    imgAlt: 'Smartwatch — smarta klockor',
  },
  {
    label: 'Billiga klockor',
    desc: 'De bästa klockmynten under 1 000 kr. Vad du faktiskt får i olika prisklasser — och vad du ska titta på.',
    slug: 'billiga-klockor',
    img: '/img/klocka-og.png',
    imgAlt: 'Billiga klockor — köpguide',
  },
  {
    label: 'Klockarmband',
    desc: 'Byt armband och förnya din klocka. Guide till material, bredd och hur du hittar rätt ersättningsband.',
    slug: 'klockarmband',
    img: '/img/klocka-og.png',
    imgAlt: 'Klockarmband — guide',
  },
  {
    label: 'Klocka i present',
    desc: 'Ge bort en klocka som present. Tips på populära presentmodeller i alla prisklasser och stilar.',
    slug: 'klocka-present',
    img: '/img/klocka-og.png',
    imgAlt: 'Klocka i present — presentguide',
  },
];
---

<Layout
  title="Klockor – köpguide i alla prisklasser | Klocka.com"
  description="Köpguider för klockor — herrur, damur, sportwatch, smartwatch, billiga klockor och klockarmband. Hitta rätt klocka för din stil och din budget."
  ogImage="/img/og-damklockor.jpg"
>
  <div class="page-index">
    <header class="index-header">
      <h1>Klockor</h1>
      <div class="index-intro prose">
        <p>
          En klocka kan vara mycket mer än ett sätt att se vad klockan är. Den berättar något om
          dig — din stil, dina prioriteringar, om du föredrar klassiskt hantverk eller modern teknik.
          Klockor köps av många anledningar: som vardagsur, träningspartner, statussymbol, present eller
          för att komplettera en unik look. Den här sidan samlar Klocka.coms köpguider för alla de vanligaste
          klockkategorierna, med ärlika råd om vad du faktiskt får för pengarna i varje prisklass.
        </p>
        <p>
          Letar du efter ett <strong>herrur</strong>? Vi täcker allt från budgetmodeller till
          lyxklockor från Omega och Rolex, med fokus på vad du faktiskt får för pengarna i varje
          prisklass. Söker du <strong>damur</strong>? Vår guide går igenom eleganta modeller från
          märken som Daniel Wellington, Longines och Tissot — samt hur du väljer mellan klassiskt,
          minimalistiskt och modernt.
        </p>
        <p>
          Vill du ha en klocka för träning? Välj mellan en <strong>sportwatch</strong> med GPS,
          pulsmätning och konditionsanalys (Garmin, Polar, Suunto, Coros) eller en
          <strong>smartwatch</strong> som kombinerar notiser, hälsofunktioner och klockutseende
          (Apple Watch, Samsung Galaxy Watch). Vi jämför de populäraste modellerna i båda kategorierna.
        </p>
        <p>
          Har du en snäv budget? Guiden om <strong>billiga klockor</strong> visar vad du kan
          förvänta dig och vilka märken som håller kvaliteten. Vill du ge bort en klocka som present?
          Se <a href="/klockor/klocka-present/">presentguiden för klockor</a>. Behöver du ett nytt
          armband? <a href="/klockor/klockarmband/">Klockarmbandsguiden</a> tar upp material,
          bredd och var du hittar ersättningsband.
        </p>
        <p>
          Letar du efter ett specifikt märke? Se våra <a href="/klockmarken/">märkesguider</a>
          för Omega, Rolex, Breitling, Longines, Casio och fler. Varje märkesguide täcker historik,
          populära serier och var du köper i Sverige.
        </p>
      </div>
    </header>

    <nav class="category-grid" aria-label="Klockategorier">
      {categories.map(({ label, desc, slug, img, imgAlt }) => (
        <a href={`/klockor/${slug}/`} class="category-card">
          <div class="category-card-img">
            <img src={img} alt={imgAlt} width="400" height="210" loading="lazy" decoding="async" />
          </div>
          <div class="category-card-body">
            <h2>{label}</h2>
            <p>{desc}</p>
            <span class="category-cta">Läs köpguide →</span>
          </div>
        </a>
      ))}
    </nav>

  </div>
</Layout>

<style>
  .page-index {
    max-width: var(--max-w-content);
    margin-inline: auto;
    padding: var(--space-8) var(--space-4);
  }
  .index-header h1 {
    font-size: var(--text-3xl);
    font-weight: 700;
    margin: 0 0 var(--space-3);
    letter-spacing: -0.02em;
  }
  .index-header p {
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-8);
  }

  .category-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    margin-bottom: var(--space-8);
  }
  @media (min-width: 640px) {
    .category-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .category-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.15s, border-color 0.15s;
  }
  .category-card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
  }

  .category-card-img img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
  }

  .category-card-body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .category-card-body h2 {
    font-size: var(--text-xl);
    font-weight: 700;
    margin: 0;
  }

  .category-card-body p {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    margin: 0;
    line-height: 1.5;
  }

  .category-cta {
    margin-top: auto;
    padding-top: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
  }

  .brand-link {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }
  .brand-link a { color: var(--color-accent); }
</style>
