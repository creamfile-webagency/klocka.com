---
import ToolLayout from '@/layouts/ToolLayout.astro';

const howToSteps = [
  { name: 'Välj tillagningstid', text: 'Välj ett äggförinställt alternativ — löskokt (4 min), mellankokt (6 min) eller hårdkokt (10 min) — eller välj en kökspresets, eller ange din egna tid.' },
  { name: 'Starta', text: 'Klicka på Starta direkt när du lägger ner ägget i vattnet.' },
  { name: 'Vänta på larmet', text: 'Klockan larmar när tiden är ute — ta upp ägget och lägg det i kallt vatten om du vill stoppa tillagningen.' },
];
const faqItems = [
  { question: 'Räknas koktiden från kallt vatten eller kokande vatten?', answer: 'Förinställningarna gäller ägg som läggs i redan kokande vatten. Startar du från kallt vatten, lägg till ca 2 minuter.' },
  { question: 'Kan jag använda äggklockan som vanlig kökstimer?', answer: 'Ja — ange din önskade tid manuellt i tidsfälten och klicka på Start.' },
  { question: 'Vad händer om ägget kokar för länge?', answer: 'Överkokta ägg får en grå-grön ring runt gulan. Det är ofarligt men påverkar konsistensen. Häll kallvatten direkt för att stoppa kokningen.' },
  { question: 'Fungerar timern i bakgrunden?', answer: 'Ja, tidmätningen fortsätter i bakgrunden, men håll fliken aktiv med ljud på för att larmet ska höras.' },
  { question: 'Hur stora ägg gäller tiderna för?', answer: 'Förinställningarna är baserade på ägg i normalstorlek (M). Stora ägg (L) kan behöva 30–60 sekunder extra.' },
];
---
<ToolLayout
  slug="aggklocka"
  title="Äggklocka online — Gratis kökstimer | Klocka.com"
  description="Äggklocka online — välj löskokt, mellankokt eller hårdkokt, eller ange valfri tid och kör som kökstimer. Larmet hörs när timern nått noll. Gratis."
  howToSteps={howToSteps}
  faqItems={faqItems}
>
  <p slot="intro">Tryck på äggtyp, tryck Start — och du vet exakt när äggen är klara. Klockan räknar ner och larmar.</p>

  <div slot="tool">
    <!-- Countdown display -->
    <div class="timer-display" id="timer-display" aria-live="off">
      <span id="timer-text" class="timer-text">04:00</span>
    </div>

    <!-- Egg presets -->
    <div class="preset-section">
      <span class="preset-section-label" aria-label="Äggförinställningar">🥚 Ägg</span>
      <div class="presets-row" role="group" aria-label="Äggförinställningar">
        <button class="preset-btn egg-btn active" data-seconds="240">Löskokt<small>4 min</small></button>
        <button class="preset-btn egg-btn" data-seconds="360">Mellankokt<small>6 min</small></button>
        <button class="preset-btn egg-btn" data-seconds="600">Hårdkokt<small>10 min</small></button>
      </div>
    </div>

    <!-- Kitchen presets -->
    <div class="preset-section">
      <span class="preset-section-label">🍳 Kök</span>
      <div class="presets-row" role="group" aria-label="Köksförinställningar">
        <button class="preset-btn" data-seconds="60">1 min</button>
        <button class="preset-btn" data-seconds="180">3 min</button>
        <button class="preset-btn" data-seconds="300">5 min</button>
        <button class="preset-btn" data-seconds="600">10 min</button>
        <button class="preset-btn" data-seconds="900">15 min</button>
        <button class="preset-btn" data-seconds="1200">20 min</button>
      </div>
    </div>

    <!-- Custom time input -->
    <div class="custom-row" id="custom-row">
      <label class="custom-label" for="custom-minutes">Egen tid (min)</label>
      <input
        type="number"
        id="custom-minutes"
        class="custom-input"
        min="1"
        max="120"
        value=""
        placeholder="–"
        aria-label="Ange antal minuter"
        inputmode="numeric"
      />
    </div>

    <!-- Controls -->
    <div class="controls-row">
      <button id="startPauseBtn" class="btn btn-primary">Starta</button>
      <button id="resetBtn" class="btn btn-ghost">Återställ</button>
    </div>

    <!-- Alarm banner -->
    <div id="alarm-banner" class="alarm-banner" role="alert" aria-live="assertive" hidden>
      <span class="alarm-text">⏰ Timern är klar!</span>
      <button id="dismissBtn" class="btn btn-primary">Avfärda</button>
    </div>

    <!-- ARIA live region -->
    <p id="status-msg" class="sr-only" aria-live="assertive" aria-atomic="true"></p>

    <p class="shortcuts-hint">
      <kbd>Enter</kbd> starta/pausa &nbsp;·&nbsp; <kbd>Esc</kbd> återställ
    </p>
  </div>

  <Fragment slot="content">
    <h2>Hur länge ska ägget koka?</h2>
    <p>
      Koktiden beror på äggstorlek, om det kommer rakt ur kylen och hur stort kastrullsutrymme du har.
      Tiderna nedan gäller för medelstora ägg (M) lagda i redan kokande vatten och kan behöva justeras
      med 30–60 sekunder beroende på din spis och dina preferenser.
    </p>

    <table>
      <thead>
        <tr><th>Kokning</th><th>Tid (fr. kokande vatten)</th><th>Resultat</th></tr>
      </thead>
      <tbody>
        <tr><td>Löskokt</td><td>ca 4 minuter</td><td>Vitan koagulerad, gulan flytande</td></tr>
        <tr><td>Mellankokt</td><td>ca 6 minuter</td><td>Vitan fast, gulan krämig</td></tr>
        <tr><td>Hårdkokt</td><td>ca 10 minuter</td><td>Helt genomkokt</td></tr>
      </tbody>
    </table>

    <p>
      Bästa resultatet får du om du tar ut ägget ur kylen 5–10 minuter innan kokning och lägger det
      försiktigt i det kokande vattnet med en sked. Ha en skål med kallt vatten redo — lägg direkt ner
      ägget när timern larmar för att stoppa tillagningen och underlätta skalning.
    </p>

    <h2>Äggklockan som kökstimer</h2>
    <p>
      Verktyget fungerar utmärkt som kökstimer för allt i köket. Ange din önskade tid manuellt och starta.
      Vanliga användningsfall:
    </p>
    <ul>
      <li><strong>Pasta:</strong> 8–12 minuter beroende på sort (se förpackningen).</li>
      <li><strong>Ris:</strong> varierar med ristyp och tillvägagångssätt.</li>
      <li><strong>Grönsaker i ångkorg:</strong> 5–8 minuter beroende på grönsak och önskad konsistens.</li>
      <li><strong>Bakat bröd eller kakor:</strong> ange exakt baktid från receptet.</li>
      <li><strong>Kött i ugn:</strong> starta timern för att inte missa tagningstiden.</li>
    </ul>

    <h2>Tips för perfekta ägg</h2>
    <ul>
      <li>Ta ut äggen ur kylen 5–10 minuter innan kokning för jämnare värmedistribution.</li>
      <li>Lägg försiktigt ner ägget med en sked — undviker sprickor och kokvattenstänk.</li>
      <li>Ha isvatten redo: lägg ägget direkt i kallt vatten när larmet går för att stoppa kokningen och göra det lättare att skala.</li>
      <li>Äldre ägg (nära bäst-före) skalar lättare än nyfärska ägg — spara nyfärska till löskokta.</li>
      <li>Starta timern i exakt samma ögonblick som du lägger ner ägget — inte när vattnet kokar igen.</li>
    </ul>

    <h2>Varför skiljer sig koktiderna åt?</h2>
    <p>
      Koktiden påverkas av flera faktorer: äggstorlek, kylskåpstemperatur, höjd över havet (lägre lufttryck
      = lägre kokpunkt = längre koktid) och hur mycket vatten du kokar. Förinställningarna i klockan är bra
      riktmärken, men skriv gärna ner hur din spis och dina ägg beter sig första gångerna. Inom ett par försök
      vet du exakt hur lång tid just ditt favoritägg tar med just din spis.
    </p>
    <p>
      Höjdskillnaden spelar sällan roll i Sverige, men om du befinner dig i en stad på hög höjd kan du
      behöva lägga till 30–60 sekunder extra. Vid normala förhållanden på låg höjd gäller standardtiderna.
    </p>

    <h2>Vanliga frågor om äggklockan</h2>
    <dl class="faq">
      <dt>Räknas koktiden från kallt vatten eller kokande vatten?</dt>
      <dd>Förinställningarna gäller ägg lagda i redan kokande vatten. Startar du från kallt vatten, lägg till ca 2 minuter.</dd>

      <dt>Kan jag använda äggklockan som vanlig kökstimer?</dt>
      <dd>Ja — ange din önskade tid manuellt i tidsfälten och klicka på Start.</dd>

      <dt>Vad händer om ägget kokar för länge?</dt>
      <dd>Överkokta ägg får en grå-grön ring runt gulan. Det är ofarligt men påverkar konsistensen. Häll kallvatten direkt för att stoppa kokningen.</dd>

      <dt>Fungerar timern i bakgrunden?</dt>
      <dd>Ja, tidmätningen fortsätter i bakgrunden, men håll fliken aktiv med ljud på för att larmet ska höras.</dd>

      <dt>Hur stora ägg gäller tiderna för?</dt>
      <dd>Förinställningarna är baserade på ägg i normalstorlek (M). Stora ägg (L) kan behöva 30–60 sekunder extra.</dd>
    </dl>
  </Fragment>
</ToolLayout>

<style>
  /* ── Timer display ── */
  .timer-display {
    text-align: center;
    padding: var(--space-8) var(--space-4) var(--space-6);
    border-radius: var(--radius-xl);
    background: var(--color-surface-2);
    margin-bottom: var(--space-6);
    transition: background var(--transition-base);
  }
  .timer-display.alarm {
    animation: alarm-pulse 0.6s ease-in-out infinite alternate;
  }
  @keyframes alarm-pulse {
    from { background: var(--color-surface-2); }
    to   { background: #fee2e2; }
  }
  @media (prefers-reduced-motion: reduce) {
    .timer-display.alarm { animation: none; background: #fee2e2; }
  }

  .timer-text {
    display: block;
    font-family: var(--font-mono);
    font-size: clamp(3.5rem, 16vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    transition: color var(--transition-fast);
  }
  .timer-text.low-time { color: var(--color-warn); }
  .timer-text.done     { color: var(--color-danger); }

  /* ── Preset sections ── */
  .preset-section {
    margin-bottom: var(--space-4);
  }
  .preset-section-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-2);
  }
  .presets-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .preset-btn {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink-muted);
    cursor: pointer;
    transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
    min-height: 36px;
    line-height: 1.2;
    gap: 1px;
  }
  .preset-btn small {
    font-size: 0.65rem;
    font-weight: 400;
    opacity: 0.75;
    display: block;
  }
  .egg-btn {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-lg);
    font-size: var(--text-base);
    font-weight: 600;
    flex: 1;
  }
  @media (max-width: 360px) {
    .egg-btn { flex: 0 0 auto; font-size: var(--text-sm); }
  }
  .preset-btn:hover {
    background: var(--color-surface-2);
    color: var(--color-ink);
    border-color: var(--color-accent);
  }
  .preset-btn.active {
    background: var(--color-accent);
    color: #fff;
    border-color: var(--color-accent);
  }
  .preset-btn.active small { opacity: 0.85; }

  /* ── Custom input ── */
  .custom-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }
  .custom-label {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink-muted);
    white-space: nowrap;
  }
  .custom-input {
    width: 5rem;
    padding: var(--space-2) var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-ink);
    background: var(--color-surface);
    text-align: center;
    min-height: 44px;
    -moz-appearance: textfield;
  }
  .custom-input::-webkit-inner-spin-button,
  .custom-input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  .custom-input:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
    border-color: var(--color-accent);
  }
  .custom-row.disabled { opacity: 0.45; pointer-events: none; }

  /* ── Controls ── */
  .controls-row {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .controls-row .btn-primary { min-width: 8rem; }

  /* ── Alarm banner ── */
  .alarm-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-4);
    background: #fee2e2;
    border: 1px solid #fca5a5;
    border-radius: var(--radius-lg);
  }
  .alarm-text {
    font-weight: 600;
    color: #991b1b;
    font-size: var(--text-base);
  }

  /* ── Keyboard hint ── */
  .shortcuts-hint {
    text-align: center;
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    margin: var(--space-2) 0 0;
  }
  kbd {
    display: inline-block;
    padding: 2px 6px;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0);
    white-space: nowrap; border-width: 0;
  }
</style>

<script>
(function () {
  const timerTextEl   = document.getElementById('timer-text')     as HTMLElement | null;
  const timerDisplay  = document.getElementById('timer-display')  as HTMLElement | null;
  const customMinutes = document.getElementById('custom-minutes') as HTMLInputElement | null;
  const customRow     = document.getElementById('custom-row')     as HTMLElement | null;
  const startPauseBtn = document.getElementById('startPauseBtn')  as HTMLButtonElement | null;
  const resetBtn      = document.getElementById('resetBtn')       as HTMLButtonElement | null;
  const alarmBanner   = document.getElementById('alarm-banner')   as HTMLElement | null;
  const dismissBtn    = document.getElementById('dismissBtn')     as HTMLButtonElement | null;
  const statusMsg     = document.getElementById('status-msg')     as HTMLElement | null;
  const presetBtns    = document.querySelectorAll<HTMLButtonElement>('.preset-btn');

  if (!timerTextEl || !startPauseBtn || !resetBtn) return;

  // ── State ──
  let remainingMs = 4 * 60 * 1000;
  let running     = false;
  let alarmActive = false;
  let rafId: number | null = null;
  let lastTs: number | null = null;
  let alarmIntervalId: ReturnType<typeof setInterval> | null = null;
  const originalTitle = document.title;

  // ── Audio ──
  let audioCtx: AudioContext | null = null;

  function getAudioCtx(): AudioContext | null {
    if (!audioCtx) {
      const AC = window.AudioContext ?? (window as typeof window & { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
      if (!AC) return null;
      audioCtx = new AC();
    }
    if (audioCtx.state === 'suspended') audioCtx.resume();
    return audioCtx;
  }

  function playTone(freq: number, startTime: number, duration: number, gain: number) {
    const ctx = getAudioCtx();
    if (!ctx) return;
    try {
      const osc   = ctx.createOscillator();
      const gNode = ctx.createGain();
      osc.connect(gNode);
      gNode.connect(ctx.destination);
      osc.type = 'sine';
      osc.frequency.value = freq;
      gNode.gain.setValueAtTime(0, ctx.currentTime + startTime);
      gNode.gain.linearRampToValueAtTime(gain, ctx.currentTime + startTime + 0.01);
      gNode.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + startTime + duration);
      osc.start(ctx.currentTime + startTime);
      osc.stop(ctx.currentTime + startTime + duration + 0.01);
    } catch { /* ignore */ }
  }

  function playAlarmChime() {
    // Three ascending tones
    playTone(659, 0,    0.25, 0.45);
    playTone(830, 0.20, 0.25, 0.45);
    playTone(988, 0.40, 0.45, 0.50);
  }

  // ── Helpers ──
  function formatTime(ms: number): string {
    const totalSec = Math.ceil(Math.max(0, ms) / 1000);
    const m = Math.floor(totalSec / 60);
    const s = totalSec % 60;
    return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
  }

  function announce(msg: string) {
    if (!statusMsg) return;
    statusMsg.textContent = '';
    requestAnimationFrame(() => { statusMsg.textContent = msg; });
  }

  function updateDisplay(ms: number) {
    if (!timerTextEl) return;
    const text = formatTime(ms);
    timerTextEl.textContent = text;
    const totalSec = Math.ceil(ms / 1000);
    timerTextEl.classList.toggle('low-time', totalSec <= 30 && totalSec > 0);
    timerTextEl.classList.toggle('done',     totalSec === 0);
    if (running) document.title = `${text} — Äggklocka`;
  }

  // ── Vibrate (mobile cue at alarm) ──
  function vibrateAlarm() {
    if ('vibrate' in navigator) {
      try { navigator.vibrate([400, 200, 400, 200, 400]); } catch { /* ignore */ }
    }
  }

  // ── Alarm ──
  function startAlarm() {
    alarmActive = true;
    if (alarmBanner) alarmBanner.hidden = false;
    timerDisplay?.classList.add('alarm');
    document.title = '⏰ Timern är klar!';
    playAlarmChime();
    vibrateAlarm();
    alarmIntervalId = setInterval(playAlarmChime, 2500);
    announce('Timern är klar!');
  }

  function stopAlarm() {
    alarmActive = false;
    if (alarmBanner) alarmBanner.hidden = true;
    timerDisplay?.classList.remove('alarm');
    document.title = originalTitle;
    if (alarmIntervalId !== null) {
      clearInterval(alarmIntervalId);
      alarmIntervalId = null;
    }
  }

  // ── RAF loop ──
  function loop(ts: number) {
    if (!running) return;
    if (lastTs === null) { lastTs = ts; rafId = requestAnimationFrame(loop); return; }
    const elapsed = ts - lastTs;
    lastTs = ts;
    remainingMs -= elapsed;

    if (remainingMs <= 0) {
      remainingMs = 0;
      updateDisplay(0);
      stopLoop(false);
      startAlarm();
      return;
    }

    updateDisplay(remainingMs);
    rafId = requestAnimationFrame(loop);
  }

  function stopLoop(restoreTitle = true) {
    running = false;
    if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; }
    lastTs = null;
    if (startPauseBtn) startPauseBtn.textContent = 'Starta';
    if (restoreTitle) document.title = originalTitle;
  }

  // ── Timer controls ──
  function startTimer() {
    if (running || remainingMs <= 0) return;
    running = true;
    lastTs = null;
    if (startPauseBtn) startPauseBtn.textContent = 'Pausa';
    customRow?.classList.add('disabled');
    rafId = requestAnimationFrame(loop);
  }

  function pauseTimer() {
    stopLoop(true);
    customRow?.classList.remove('disabled');
  }

  function setPreset(seconds: number) {
    remainingMs = seconds * 1000;
    if (customMinutes) customMinutes.value = '';
    updateDisplay(remainingMs);
  }

  function resetTimer() {
    stopLoop(true);
    stopAlarm();
    // Find the active preset
    const active = document.querySelector<HTMLButtonElement>('.preset-btn.active');
    if (active) {
      remainingMs = parseInt(active.dataset.seconds ?? '240', 10) * 1000;
    }
    customRow?.classList.remove('disabled');
    if (customMinutes) customMinutes.value = '';
    updateDisplay(remainingMs);
    announce('');
  }

  // ── Event listeners ──
  startPauseBtn?.addEventListener('click', () => {
    if (alarmActive) { stopAlarm(); resetTimer(); return; }
    running ? pauseTimer() : startTimer();
  });

  resetBtn?.addEventListener('click', resetTimer);

  dismissBtn?.addEventListener('click', () => {
    stopAlarm();
    resetTimer();
  });

  presetBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      if (running) return;
      const secs = parseInt(btn.dataset.seconds ?? '0', 10);
      setPreset(secs);
      presetBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    });
  });

  customMinutes?.addEventListener('input', () => {
    if (running) return;
    const mins = Math.max(1, Math.min(120, parseInt(customMinutes.value, 10) || 0));
    if (mins > 0 && customMinutes.value !== '') {
      remainingMs = mins * 60 * 1000;
      updateDisplay(remainingMs);
      presetBtns.forEach(b => b.classList.remove('active'));
    }
  });

  document.addEventListener('keydown', (e: KeyboardEvent) => {
    const tag = (document.activeElement as HTMLElement)?.tagName;
    if (tag === 'INPUT' || tag === 'SELECT' || tag === 'TEXTAREA') return;
    if (e.code === 'Enter') {
      e.preventDefault();
      if (alarmActive) { stopAlarm(); resetTimer(); return; }
      running ? pauseTimer() : startTimer();
    } else if (e.code === 'Escape') {
      e.preventDefault();
      resetTimer();
    }
  });

  // Init
  updateDisplay(remainingMs);
})();
</script>
