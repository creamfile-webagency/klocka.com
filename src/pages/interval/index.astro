---
import ToolLayout from '@/layouts/ToolLayout.astro';

const howToSteps = [
  { name: 'Välj preset eller ange egna tider', text: 'Välj Tabata (20s/10s × 8), EMOM (60s × 10) eller ange egna arbetstider, vilotider och antal rundor under Inställningar.' },
  { name: 'Tryck Starta', text: 'Klockan börjar räkna ner för första arbetsintervallet. Den stora siffran visar sekunder kvar i pågående fas.' },
  { name: 'Följ ljud- och bildindikationerna', text: 'Tre korta pip varnar sista tre sekunderna i varje fas. Dubbel ton signalerar fasbyte.' },
  { name: 'Pausa, hoppa eller återställ', text: 'Pausa när som helst, hoppa till nästa fas med Hoppa fas, eller börja om med Återställ.' },
];
---
<ToolLayout
  slug="interval"
  title="Intervallklocka — HIIT & Tabata-timer | Klocka.com"
  description="Gratis intervallklocka online för HIIT, Tabata och EMOM. Ange arbets- och vilotider, antal rundor och tryck start. Nedräkningsljud, fasbyte-larm och skärmväckning ingår."
  howToSteps={howToSteps}
>
  <p slot="intro">Ange arbets- och viloperioder, välj antal ronder och tryck Start. Klockan larmar vid varje fasbyte och visar tydligt om du ska köra eller vila — perfekt för HIIT, Tabata och EMOM.</p>

  <div slot="tool">
    <div id="iv" role="application" aria-label="Intervallklocka">

      <!-- Phase badge + round label -->
      <div class="iv-phase-area">
        <div class="iv-phase-badge" id="ivPhase" aria-live="assertive" aria-atomic="true">KLAR</div>
        <div class="iv-round-label" id="ivRound" aria-live="polite">VARV 0/8</div>
      </div>

      <!-- Big countdown -->
      <div class="iv-countdown" id="ivCountdown" aria-live="off">20</div>

      <!-- Totals row -->
      <div class="iv-totals">
        <div class="iv-time-stat">
          <span class="iv-time-label">Förfluten</span>
          <span class="iv-time-val" id="ivElapsed">0:00</span>
        </div>
        <div class="iv-time-divider" aria-hidden="true"></div>
        <div class="iv-time-stat">
          <span class="iv-time-label">Kvar totalt</span>
          <span class="iv-time-val" id="ivRemaining">3:50</span>
        </div>
      </div>

      <!-- Controls -->
      <div class="iv-controls">
        <button id="ivStartPause" class="btn btn-primary">Starta</button>
        <button id="ivSkip" class="btn btn-ghost" disabled>Hoppa fas</button>
        <button id="ivReset" class="btn btn-ghost">Återställ</button>
      </div>

      <!-- Preset shortcuts -->
      <div class="iv-presets" role="group" aria-label="Snabbinställningar">
        <button class="iv-preset-btn" data-preset="tabata" aria-pressed="true">Tabata 20/10×8</button>
        <button class="iv-preset-btn" data-preset="emom" aria-pressed="false">EMOM 60s×10</button>
        <button class="iv-preset-btn" data-preset="custom" aria-pressed="false">Anpassad</button>
      </div>

      <!-- Settings -->
      <details class="iv-settings-panel">
        <summary class="iv-settings-toggle">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="3"/>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
          </svg>
          Inställningar
        </summary>
        <div class="iv-settings-grid">
          <label class="iv-field">
            <span class="iv-field-label">Arbetstid (sek)</span>
            <input type="number" id="ivWorkSecs" min="5" max="300" value="20" class="setting-input" aria-label="Arbetstid i sekunder" />
          </label>
          <label class="iv-field">
            <span class="iv-field-label">Vilotid (sek)</span>
            <input type="number" id="ivRestSecs" min="0" max="300" value="10" class="setting-input" aria-label="Vilotid i sekunder" />
          </label>
          <label class="iv-field">
            <span class="iv-field-label">Antal rundor</span>
            <input type="number" id="ivRoundsCount" min="1" max="99" value="8" class="setting-input" aria-label="Antal rundor" />
          </label>
        </div>
      </details>

      <!-- Keyboard hints -->
      <p class="iv-hints">
        <kbd>Enter</kbd> starta/pausa &nbsp;·&nbsp;
        <kbd>Space</kbd> hoppa fas &nbsp;·&nbsp;
        <kbd>Esc</kbd> återställ
      </p>
    </div>

    <!-- ARIA live region -->
    <p id="ivStatus" class="iv-sr-only" aria-live="assertive" aria-atomic="true"></p>
  </div>

  <Fragment slot="content">
    <h2>Om intervallklockan</h2>
    <p>
      Intervallträning — HIIT, Tabata, EMOM eller egna upplägg — kräver att du vet exakt när arbets- och
      vilofaser börjar och slutar. Att titta på en vanlig klocka eller försöka räkna sekunder i huvudet fungerar
      dåligt när du är andfådd och fokuserad på rörelsen. En dedikerad intervallklocka tar bort det problemet helt.
    </p>
    <p>
      Med Klocka.coms intervallklocka ställer du in arbetstid, vilotid och antal rundor en gång, sedan larmar
      klockan vid varje fasbyte. Du hör när du ska köra hårt och när du ska vila — utan att behöva kika på
      skärmen mitt i en burpee. Klockan visar tydligt vilken fas du är i och hur många rundor som återstår.
    </p>
    <h3>Vad är HIIT?</h3>
    <p>
      HIIT (High-Intensity Interval Training) är en träningsform där korta intensiva arbetsperioder varvas med
      kortare viloperioder. Metoden är tidseffektiv och ger hög energiförbrukning både under och efter passet —
      det så kallade efterförbränningseffekten. Intervallklockan håller strukturen åt dig så du kan fokusera
      helt på träningen.
    </p>
    <h3>Tabata-protokollet</h3>
    <p>
      Tabata är ett av de vanligaste HIIT-protokollen: 20 sekunder maximalt arbete följt av 10 sekunder vila,
      upprepat 8 gånger — totalt knappt 4 minuter. Välj Tabata-preseten i klockan för att komma igång direkt.
    </p>
    <h3>EMOM — Every Minute On the Minute</h3>
    <p>
      EMOM innebär att du utför ett visst antal rörelser i början av varje minut och vilar resten av minuten.
      Välj EMOM-preseten (60 sekunder × 10 rundor) och anpassa efter ditt program.
    </p>
  </Fragment>
</ToolLayout>

<style>
  #iv {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
  }

  .iv-phase-area {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .iv-phase-badge {
    font-size: var(--text-xl);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: var(--space-2) var(--space-5);
    border-radius: var(--radius-lg);
    line-height: 1;
    border: 1.5px solid transparent;
    transition: background var(--transition-base), color var(--transition-base), border-color var(--transition-base);
  }
  .iv-phase-badge.idle {
    background: var(--color-surface-2);
    color: var(--color-ink-muted);
    border-color: var(--color-border);
  }
  .iv-phase-badge.work {
    background: color-mix(in srgb, var(--color-success) 10%, var(--color-surface));
    color: var(--color-success);
    border-color: color-mix(in srgb, var(--color-success) 35%, transparent);
  }
  .iv-phase-badge.rest {
    background: color-mix(in srgb, var(--color-accent) 10%, var(--color-surface));
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 30%, transparent);
  }
  .iv-phase-badge.done {
    background: color-mix(in srgb, var(--color-success) 10%, var(--color-surface));
    color: var(--color-success);
    border-color: color-mix(in srgb, var(--color-success) 35%, transparent);
  }

  .iv-round-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink-muted);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    min-height: 1.25rem;
  }

  .iv-countdown {
    font-size: clamp(5rem, 25vw, 8rem);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-ink);
    min-height: 1em;
    transition: color var(--transition-fast);
  }
  .iv-countdown.work { color: var(--color-success); }
  .iv-countdown.rest { color: var(--color-accent); }
  .iv-countdown.urgent {
    color: var(--color-danger);
    animation: iv-pulse 0.5s ease-in-out infinite;
  }
  .iv-countdown.done { color: var(--color-success); }

  @keyframes iv-pulse {
    0%, 100% { transform: scale(1); }
    50%       { transform: scale(1.06); }
  }
  @media (prefers-reduced-motion: reduce) {
    .iv-countdown.urgent { animation: none; }
  }

  .iv-totals {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-3) var(--space-6);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    min-width: 220px;
  }
  .iv-time-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    flex: 1;
  }
  .iv-time-label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }
  .iv-time-val {
    font-size: var(--text-2xl);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .iv-time-divider {
    width: 1px;
    height: 2.5rem;
    background: var(--color-border);
    flex-shrink: 0;
  }

  .iv-controls {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
  }
  .iv-controls .btn {
    flex: 1;
    min-width: 90px;
    max-width: 140px;
  }

  .iv-presets {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    justify-content: center;
  }
  .iv-preset-btn {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-2);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink-muted);
    cursor: pointer;
    transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
    min-height: 36px;
    white-space: nowrap;
  }
  .iv-preset-btn:hover {
    background: var(--color-surface);
    color: var(--color-ink);
  }
  .iv-preset-btn[aria-pressed="true"] {
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-surface));
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
  }

  .iv-settings-panel {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-4);
    width: 100%;
  }
  .iv-settings-toggle {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    cursor: pointer;
    list-style: none;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink-muted);
    padding: var(--space-1) 0;
    user-select: none;
  }
  .iv-settings-toggle:hover { color: var(--color-ink); }
  .iv-settings-toggle::-webkit-details-marker { display: none; }
  .iv-settings-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    padding-top: var(--space-4);
  }
  @media (max-width: 420px) {
    .iv-settings-grid { grid-template-columns: 1fr; }
  }
  .iv-field { display: flex; flex-direction: column; gap: var(--space-1); }
  .iv-field-label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .setting-input {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-ink);
    background: var(--color-surface);
    min-height: 44px;
    width: 100%;
    text-align: center;
  }
  .setting-input:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
    border-color: var(--color-accent);
  }

  .iv-hints {
    text-align: center;
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    margin: 0;
  }
  kbd {
    display: inline-block;
    padding: 2px 6px;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .iv-sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border-width: 0;
  }
</style>

<script>
  (function () {
    const phaseBadge    = document.getElementById('ivPhase');
    const roundLabelEl  = document.getElementById('ivRound');
    const countdownEl   = document.getElementById('ivCountdown');
    const elapsedEl     = document.getElementById('ivElapsed');
    const remainingEl   = document.getElementById('ivRemaining');
    const startPauseBtn = document.getElementById('ivStartPause') as HTMLButtonElement | null;
    const skipBtn       = document.getElementById('ivSkip') as HTMLButtonElement | null;
    const resetBtn      = document.getElementById('ivReset') as HTMLButtonElement | null;
    const workInput     = document.getElementById('ivWorkSecs') as HTMLInputElement | null;
    const restInput     = document.getElementById('ivRestSecs') as HTMLInputElement | null;
    const roundsInput   = document.getElementById('ivRoundsCount') as HTMLInputElement | null;
    const presetBtns    = Array.from(document.querySelectorAll<HTMLButtonElement>('.iv-preset-btn'));
    const statusEl      = document.getElementById('ivStatus');

    if (!phaseBadge || !startPauseBtn || !skipBtn || !resetBtn || !workInput || !restInput || !roundsInput) return;

    // ── Audio (Web Audio API, lazy init after user gesture) ──
    let audioCtx: AudioContext | null = null;
    let scheduledOscs: OscillatorNode[] = [];

    function getCtx(): AudioContext | null {
      if (audioCtx) return audioCtx;
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      const W = window as any;
      const Ctor: typeof AudioContext | undefined = W.AudioContext ?? W.webkitAudioContext;
      if (!Ctor) return null;
      audioCtx = new Ctor();
      return audioCtx;
    }

    function scheduleBeep(when: number, freq: number, dur: number, vol = 0.45) {
      const ctx = getCtx();
      if (!ctx) return;
      const t = Math.max(when, ctx.currentTime + 0.005);
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.connect(g);
      g.connect(ctx.destination);
      osc.type = 'sine';
      osc.frequency.value = freq;
      g.gain.setValueAtTime(vol, t);
      g.gain.exponentialRampToValueAtTime(0.001, t + dur);
      osc.start(t);
      osc.stop(t + dur + 0.05);
      scheduledOscs.push(osc);
      osc.onended = () => { scheduledOscs = scheduledOscs.filter(o => o !== osc); };
    }

    function cancelScheduled() {
      const ctx = getCtx();
      const now = ctx ? ctx.currentTime : 0;
      for (const osc of scheduledOscs) {
        try { osc.stop(now); } catch { /* already ended */ }
      }
      scheduledOscs = [];
    }

    function beepPhaseChange() {
      const ctx = getCtx();
      if (!ctx) return;
      const t = ctx.currentTime;
      scheduleBeep(t,       1100, 0.18);
      scheduleBeep(t + 0.28, 1100, 0.18);
    }

    function beepDone() {
      const ctx = getCtx();
      if (!ctx) return;
      const t = ctx.currentTime;
      scheduleBeep(t,       880,  0.15);
      scheduleBeep(t + 0.2, 1100, 0.15);
      scheduleBeep(t + 0.4, 1320, 0.35);
    }

    // Pre-schedule countdown beeps on Web Audio timeline (works in background tabs)
    function scheduleCountdownBeeps(phaseRemainingSec: number) {
      const ctx = getCtx();
      if (!ctx) return;
      const now = ctx.currentTime;
      for (const sec of [3, 2, 1]) {
        const delay = phaseRemainingSec - sec;
        if (delay >= -0.1) scheduleBeep(now + Math.max(delay, 0), 880, 0.12);
      }
    }

    // ── Wake lock ──
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    let wakeLock: any = null;
    async function requestWakeLock() {
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      if (!('wakeLock' in navigator)) return;
      try { wakeLock = await (navigator as any).wakeLock.request('screen'); } catch { /* unsupported */ }
    }
    function releaseWakeLock() {
      if (wakeLock) { wakeLock.release().catch(() => {}); wakeLock = null; }
    }
    document.addEventListener('visibilitychange', () => {
      if (running && document.visibilityState === 'visible') requestWakeLock();
    });

    // ── Phase model ──
    interface Phase { type: 'work' | 'rest'; round: number; duration: number; }
    let phases: Phase[] = [];

    function buildPhases(workSec: number, restSec: number, rounds: number) {
      phases = [];
      for (let r = 1; r <= rounds; r++) {
        phases.push({ type: 'work', round: r, duration: workSec });
        if (r < rounds && restSec > 0) phases.push({ type: 'rest', round: r, duration: restSec });
      }
    }

    function phaseStartAt(idx: number): number {
      let acc = 0;
      for (let i = 0; i < idx; i++) acc += phases[i].duration;
      return acc;
    }

    function totalDur(): number {
      return phases.reduce((s, p) => s + p.duration, 0);
    }

    function phaseAt(t: number): { idx: number; remaining: number } | null {
      let acc = 0;
      for (let i = 0; i < phases.length; i++) {
        const end = acc + phases[i].duration;
        if (t < end) return { idx: i, remaining: end - t };
        acc = end;
      }
      return null;
    }

    function numRounds(): number {
      return phases.filter(p => p.type === 'work').length;
    }

    // ── Timer state ──
    let running    = false;
    let elapsedSec = 0;
    let wallStart  = 0;
    let tickTimer: ReturnType<typeof setInterval> | null = null;
    let lastPhaseIdx = -1;
    let isDone = false;

    function getElapsed(): number {
      if (!running) return elapsedSec;
      return elapsedSec + (Date.now() - wallStart) / 1000;
    }

    function fmt(sec: number): string {
      const s = Math.round(Math.max(0, sec));
      const m = Math.floor(s / 60);
      const ss = s % 60;
      return `${m}:${ss < 10 ? '0' : ''}${ss}`;
    }

    function announce(msg: string) {
      if (!statusEl) return;
      statusEl.textContent = '';
      requestAnimationFrame(() => { if (statusEl) statusEl.textContent = msg; });
    }

    function stopTimer() {
      if (tickTimer) { clearInterval(tickTimer); tickTimer = null; }
      running = false;
    }

    function updateUI(elapsed: number) {
      const info = phaseAt(elapsed);

      if (!info) {
        if (!isDone) {
          isDone = true;
          stopTimer();
          beepDone();
          releaseWakeLock();
          announce('Träningspasset klart!');
          startPauseBtn!.textContent = 'Starta om';
          skipBtn!.disabled = true;
        }
        phaseBadge!.textContent = 'KLART!';
        phaseBadge!.className = 'iv-phase-badge done';
        roundLabelEl!.textContent = '';
        countdownEl!.textContent = '✓';
        countdownEl!.className = 'iv-countdown done';
        elapsedEl!.textContent = fmt(totalDur());
        remainingEl!.textContent = '0:00';
        return;
      }

      const ph = phases[info.idx];
      const displaySec = Math.ceil(info.remaining);
      const isUrgent = running && displaySec <= 3 && displaySec > 0;

      // Phase transition detection
      if (info.idx !== lastPhaseIdx) {
        if (running && lastPhaseIdx >= 0) {
          beepPhaseChange();
          announce(ph.type === 'work'
            ? `Arbete — varv ${ph.round}`
            : `Vila — varv ${ph.round}`);
        }
        cancelScheduled();
        if (running) scheduleCountdownBeeps(info.remaining);
        lastPhaseIdx = info.idx;
      }

      phaseBadge!.textContent = ph.type === 'work' ? 'ARBETE' : 'VILA';
      phaseBadge!.className = `iv-phase-badge ${ph.type}`;
      roundLabelEl!.textContent = `VARV ${ph.round}/${numRounds()}`;
      countdownEl!.textContent = String(displaySec);
      countdownEl!.className = `iv-countdown ${isUrgent ? 'urgent' : ph.type}`;
      elapsedEl!.textContent = fmt(elapsed);
      remainingEl!.textContent = fmt(totalDur() - elapsed);
    }

    function tick() { updateUI(getElapsed()); }

    function start() {
      if (running) return;
      if (isDone) { doReset(); return; }
      getCtx()?.resume?.();
      wallStart = Date.now();
      running = true;
      const info = phaseAt(elapsedSec);
      lastPhaseIdx = info?.idx ?? -1;
      cancelScheduled();
      if (info) scheduleCountdownBeeps(info.remaining);
      startPauseBtn!.textContent = 'Pausa';
      skipBtn!.disabled = false;
      requestWakeLock();
      tick();
      tickTimer = setInterval(tick, 200);
    }

    function pause() {
      if (!running) return;
      elapsedSec = getElapsed();
      stopTimer();
      cancelScheduled();
      releaseWakeLock();
      startPauseBtn!.textContent = 'Fortsätt';
      skipBtn!.disabled = true;
    }

    function doReset() {
      elapsedSec = 0;
      stopTimer();
      cancelScheduled();
      releaseWakeLock();
      running = false;
      lastPhaseIdx = -1;
      isDone = false;
      startPauseBtn!.textContent = 'Starta';
      skipBtn!.disabled = true;
      rebuildFromInputs();
      showIdle();
    }

    function skipPhase() {
      if (!running) return;
      const elapsed = getElapsed();
      const info = phaseAt(elapsed);
      if (!info) return;
      cancelScheduled();
      const nextStart = phaseStartAt(info.idx + 1);
      elapsedSec = nextStart;
      wallStart = Date.now();
      // lastPhaseIdx stays at info.idx so updateUI detects the transition
      tick();
    }

    function showIdle() {
      const ws = parseInt(workInput!.value, 10) || 20;
      const rounds = parseInt(roundsInput!.value, 10) || 8;
      phaseBadge!.textContent = 'KLAR';
      phaseBadge!.className = 'iv-phase-badge idle';
      roundLabelEl!.textContent = `VARV 0/${rounds}`;
      countdownEl!.textContent = String(ws);
      countdownEl!.className = 'iv-countdown';
      elapsedEl!.textContent = '0:00';
      remainingEl!.textContent = fmt(totalDur());
    }

    function rebuildFromInputs() {
      const ws = Math.max(5,  parseInt(workInput!.value,   10) || 20);
      const rs = Math.max(0,  parseInt(restInput!.value,   10) || 0);
      const ro = Math.max(1,  parseInt(roundsInput!.value, 10) || 8);
      buildPhases(ws, rs, ro);
    }

    // ── Presets ──
    const PRESETS: Record<string, { work: number; rest: number; rounds: number }> = {
      tabata: { work: 20, rest: 10, rounds: 8  },
      emom:   { work: 60, rest: 0,  rounds: 10 },
    };

    function selectPreset(name: string) {
      for (const btn of presetBtns) {
        btn.setAttribute('aria-pressed', String(btn.dataset.preset === name));
      }
    }

    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        if (running) return;
        const p = btn.dataset.preset ?? '';
        selectPreset(p);
        const preset = PRESETS[p];
        if (preset) {
          workInput!.value   = String(preset.work);
          restInput!.value   = String(preset.rest);
          roundsInput!.value = String(preset.rounds);
        }
        rebuildFromInputs();
        showIdle();
      });
    });

    [workInput, restInput, roundsInput].forEach(inp => {
      inp!.addEventListener('change', () => {
        if (running) return;
        selectPreset('custom');
        rebuildFromInputs();
        showIdle();
      });
    });

    // ── Button events ──
    startPauseBtn.addEventListener('click', () => {
      if (isDone) { doReset(); return; }
      running ? pause() : start();
    });
    skipBtn.addEventListener('click', skipPhase);
    resetBtn.addEventListener('click', doReset);

    // ── Keyboard ──
    document.addEventListener('keydown', (e) => {
      const tag = (document.activeElement as HTMLElement)?.tagName;
      if (tag === 'INPUT' || tag === 'SELECT' || tag === 'TEXTAREA') return;
      if (e.code === 'Enter') {
        e.preventDefault();
        isDone ? doReset() : (running ? pause() : start());
      } else if (e.code === 'Space') {
        e.preventDefault();
        if (running) skipPhase();
      } else if (e.code === 'Escape') {
        e.preventDefault();
        doReset();
      }
    });

    // ── Init ──
    rebuildFromInputs();
    selectPreset('tabata');
    showIdle();
  })();
</script>
