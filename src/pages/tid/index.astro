---
import Layout from '@/layouts/Layout.astro';

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Tid i världen',
    url: 'https://klocka.com/tid/',
    description: 'Aktuell tid i länder världen över. Se tidsskillnader och tidszoner.',
    inLanguage: 'sv-SE',
    isPartOf: { '@type': 'WebSite', url: 'https://klocka.com' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Klocka.com', item: 'https://klocka.com' },
      { '@type': 'ListItem', position: 2, name: 'Tid i världen', item: 'https://klocka.com/tid/' },
    ],
  },
];
---

<Layout
  title="Tid i världen | Klocka.com"
  description="Aktuell tid i länder världen över. Se tidsskillnader och tidszoner."
  schema={schemas}
>
  <div class="page-tid-hub">
    <header class="tid-header">
      <h1>Tid i världen</h1>
      <p class="tid-intro">Se aktuell tid och tidszoner för länder världen över.</p>
    </header>

    <nav class="tid-country-list" aria-label="Länder">
      <a href="/tid/kina/" class="tid-card">
        <span class="tid-card-name">Kina</span>
        <span class="tid-card-tz">CST (UTC+8)</span>
      </a>
    </nav>

    <nav class="tid-nav" aria-label="Tillbaka">
      <a href="/">← Tillbaka till startsidan</a>
    </nav>
  </div>
</Layout>

<style>
  .page-tid-hub {
    max-width: var(--max-w-content);
    margin-inline: auto;
    padding: var(--space-8) var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
  }

  .tid-header {
    text-align: center;
    max-width: 44rem;
  }

  .tid-header h1 {
    font-size: var(--text-3xl);
    font-weight: 700;
    margin: 0 0 var(--space-3);
    color: var(--color-ink);
    letter-spacing: -0.02em;
  }

  @media (min-width: 640px) {
    .tid-header h1 { font-size: var(--text-4xl); }
  }

  .tid-intro {
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
    margin: 0;
    line-height: 1.6;
  }

  .tid-country-list {
    width: 100%;
    max-width: 28rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .tid-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-5);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    text-decoration: none;
    color: var(--color-ink);
    transition: background 0.15s;
  }

  .tid-card:hover {
    background: var(--color-surface-3, var(--color-surface-2));
    border-color: var(--color-accent);
  }

  .tid-card-name {
    font-weight: 600;
    font-size: var(--text-base);
  }

  .tid-card-tz {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  .tid-nav {
    font-size: var(--text-sm);
  }

  .tid-nav a {
    color: var(--color-accent);
    text-decoration: none;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .tid-nav a:hover {
    background: var(--color-surface-2);
  }
</style>
