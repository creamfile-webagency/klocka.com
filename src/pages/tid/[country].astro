---
import TidCountryLayout from '@/layouts/TidCountryLayout.astro';
import { countries } from '@/data/countries';

export function getStaticPaths() {
  return countries.map(c => ({
    params: { country: c.slug },
    props: { slug: c.slug },
  }));
}

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const data = countries.find(c => c.slug === slug);

if (!data) {
  return Astro.redirect('/tid/', 302);
}
---

<TidCountryLayout {data} />
