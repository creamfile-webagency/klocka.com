---
import ToolLayout from '@/layouts/ToolLayout.astro';

const howToSteps = [
  { name: 'Ange tid', text: 'Skriv in timmar, minuter och sekunder i fälten, eller välj ett snabbval (1–30 min).' },
  { name: 'Starta', text: 'Klicka på Starta eller tryck Enter för att sätta igång nedräkningen.' },
  { name: 'Pausa', text: 'Klicka på Pausa om du behöver hålla kvar återstående tid.' },
  { name: 'Larm', text: 'När timern når noll spelas ett larm och en notis visas om du tillåtit det. Klicka Avfärda för att stänga av larmet.' },
];
---
<ToolLayout
  slug="nedrakning"
  title="Nedräkningstimer online — Räkna ner tid | Klocka.com"
  description="Gratis nedräkningstimer med larm. Ange din tid och starta räkna-ner klockan."
  howToSteps={howToSteps}
>
  <p slot="intro">Ange tid, tryck Start — timern räknar ner och ger ett larm när du är klar. Fungerar direkt i webbläsaren, ingen nedladdning.</p>

  <div slot="tool">
    <!-- Countdown display -->
    <div class="timer-display" id="timer-display" aria-live="off">
      <span id="timer-text" class="timer-text">05:00</span>
    </div>

    <!-- Quick presets -->
    <div class="presets-row" role="group" aria-label="Snabbval">
      <button class="preset-btn" data-seconds="60">1 min</button>
      <button class="preset-btn" data-seconds="300" data-active="true">5 min</button>
      <button class="preset-btn" data-seconds="600">10 min</button>
      <button class="preset-btn" data-seconds="900">15 min</button>
      <button class="preset-btn" data-seconds="1800">30 min</button>
    </div>

    <!-- Time inputs -->
    <div class="time-inputs" id="time-inputs">
      <label class="time-field">
        <span class="time-label">Tim</span>
        <input type="number" id="input-hours" class="time-input" min="0" max="23" value="0" aria-label="Timmar" inputmode="numeric" />
      </label>
      <span class="time-sep" aria-hidden="true">:</span>
      <label class="time-field">
        <span class="time-label">Min</span>
        <input type="number" id="input-minutes" class="time-input" min="0" max="59" value="5" aria-label="Minuter" inputmode="numeric" />
      </label>
      <span class="time-sep" aria-hidden="true">:</span>
      <label class="time-field">
        <span class="time-label">Sek</span>
        <input type="number" id="input-seconds" class="time-input" min="0" max="59" value="0" aria-label="Sekunder" inputmode="numeric" />
      </label>
    </div>

    <!-- Controls -->
    <div class="controls-row">
      <button id="startPauseBtn" class="btn btn-primary">Starta</button>
      <button id="resetBtn" class="btn btn-ghost">Återställ</button>
      <button id="muteBtn" class="btn btn-ghost btn-icon" aria-label="Ljud av" title="Ljud av/på">
        <svg id="icon-sound-on" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
          <path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
          <path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>
        </svg>
        <svg id="icon-sound-off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="display:none">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
          <line x1="23" y1="9" x2="17" y2="15"/>
          <line x1="17" y1="9" x2="23" y2="15"/>
        </svg>
      </button>
    </div>

    <!-- Alarm banner -->
    <div id="alarm-banner" class="alarm-banner" role="alert" aria-live="assertive" hidden>
      <span class="alarm-text">⏰ Timern är klar!</span>
      <button id="dismissBtn" class="btn btn-primary">Avfärda</button>
    </div>

    <!-- ARIA live region for screen readers -->
    <p id="status-msg" class="sr-only" aria-live="assertive" aria-atomic="true"></p>

    <p class="shortcuts-hint">
      <kbd>Enter</kbd> starta/pausa &nbsp;·&nbsp; <kbd>Esc</kbd> återställ
    </p>
  </div>

  <Fragment slot="content">
    <h2>Om nedräkningstimern</h2>
    <p>
      En nedräkningstimer räknar bakåt från ett valfritt startvärde och larmar när noll nås. Det är ett
      oumbärligt verktyg i köket — för pasta, ägg eller ugnsrätter — men används lika mycket i klassrum,
      på gymmet och vid workshops där talartider behöver hållas.
    </p>
    <p>
      Till skillnad från ett stoppur vet du hela tiden exakt hur lång tid du har kvar, inte hur lång tid som
      gått. Det gör nedräkningstimern idealisk i situationer där slutpunkten är det viktiga: när ska
      brödet ut ur ugnen, hur länge är det kvar av lektionen, hur mycket tid återstår av presentationen?
    </p>
    <p>
      Klocka.coms nedräkningstimer kräver ingen app och inget konto. Ange minuter och sekunder (eller
      timmar för längre nedräkningar), tryck Starta och timern sköter resten. Larmet aktiveras med
      webbläsarens Web Audio API — inget ljud laddas ner från servern.
    </p>
  </Fragment>
</ToolLayout>

<style>
  /* ── Timer display ── */
  .timer-display {
    text-align: center;
    padding: var(--space-8) var(--space-4) var(--space-6);
    border-radius: var(--radius-xl);
    background: var(--color-surface-2);
    margin-bottom: var(--space-6);
    transition: background var(--transition-base);
  }
  .timer-display.alarm {
    animation: alarm-pulse 0.6s ease-in-out infinite alternate;
  }
  @keyframes alarm-pulse {
    from { background: var(--color-surface-2); }
    to   { background: #fee2e2; }
  }
  @media (prefers-reduced-motion: reduce) {
    .timer-display.alarm { animation: none; background: #fee2e2; }
  }

  .timer-text {
    display: block;
    font-family: var(--font-mono);
    font-size: clamp(3.5rem, 16vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    transition: color var(--transition-fast);
  }
  .timer-text.low-time { color: var(--color-warn); }
  .timer-text.done     { color: var(--color-danger); }

  /* ── Presets ── */
  .presets-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }
  .preset-btn {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink-muted);
    cursor: pointer;
    transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
    min-height: 36px;
  }
  .preset-btn:hover {
    background: var(--color-surface-2);
    color: var(--color-ink);
    border-color: var(--color-accent);
  }
  .preset-btn.active {
    background: var(--color-accent);
    color: #fff;
    border-color: var(--color-accent);
  }

  /* ── Time inputs ── */
  .time-inputs {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }
  .time-inputs.disabled { opacity: 0.45; pointer-events: none; }

  .time-field {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
  }
  .time-label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .time-input {
    width: 4.5rem;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-ink);
    background: var(--color-surface);
    text-align: center;
    min-height: 48px;
    -moz-appearance: textfield;
  }
  .time-input::-webkit-inner-spin-button,
  .time-input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  .time-input:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
    border-color: var(--color-accent);
  }
  .time-sep {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-ink-muted);
    padding-bottom: var(--space-2);
  }

  /* ── Controls ── */
  .controls-row {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .controls-row .btn-primary { min-width: 8rem; }
  .btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
  }

  /* ── Alarm banner ── */
  .alarm-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-4);
    background: #fee2e2;
    border: 1px solid #fca5a5;
    border-radius: var(--radius-lg);
  }
  .alarm-text {
    font-weight: 600;
    color: #991b1b;
    font-size: var(--text-base);
  }

  /* ── Keyboard hint ── */
  .shortcuts-hint {
    text-align: center;
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    margin: var(--space-2) 0 0;
  }
  kbd {
    display: inline-block;
    padding: 2px 6px;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0);
    white-space: nowrap; border-width: 0;
  }
</style>

<script>
(function () {
  const timerTextEl  = document.getElementById('timer-text') as HTMLElement | null;
  const timerDisplay = document.getElementById('timer-display') as HTMLElement | null;
  const inputHours   = document.getElementById('input-hours')   as HTMLInputElement | null;
  const inputMinutes = document.getElementById('input-minutes') as HTMLInputElement | null;
  const inputSeconds = document.getElementById('input-seconds') as HTMLInputElement | null;
  const timeInputs   = document.getElementById('time-inputs')   as HTMLElement | null;
  const startPauseBtn = document.getElementById('startPauseBtn') as HTMLButtonElement | null;
  const resetBtn      = document.getElementById('resetBtn')      as HTMLButtonElement | null;
  const muteBtn       = document.getElementById('muteBtn')       as HTMLButtonElement | null;
  const alarmBanner   = document.getElementById('alarm-banner')  as HTMLElement | null;
  const dismissBtn    = document.getElementById('dismissBtn')    as HTMLButtonElement | null;
  const statusMsg     = document.getElementById('status-msg')    as HTMLElement | null;
  const iconSoundOn   = document.getElementById('icon-sound-on')  as SVGElement | null;
  const iconSoundOff  = document.getElementById('icon-sound-off') as SVGElement | null;
  const presetBtns    = document.querySelectorAll<HTMLButtonElement>('.preset-btn');

  if (!timerTextEl || !startPauseBtn || !resetBtn) return;

  // ── State ──
  let remainingMs  = 5 * 60 * 1000;
  let running      = false;
  let alarmActive  = false;
  let muted        = false;
  let rafId: number | null = null;
  let lastTs: number | null = null;
  let alarmIntervalId: ReturnType<typeof setInterval> | null = null;
  let notifSent    = false;
  const originalTitle = document.title;

  // ── Audio ──
  let audioCtx: AudioContext | null = null;

  function getAudioCtx(): AudioContext | null {
    if (!audioCtx) {
      const AC = window.AudioContext ?? (window as typeof window & { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
      if (!AC) return null;
      audioCtx = new AC();
    }
    if (audioCtx.state === 'suspended') audioCtx.resume();
    return audioCtx;
  }

  function playTone(freq: number, startTime: number, duration: number, gain: number) {
    const ctx = getAudioCtx();
    if (!ctx || muted) return;
    try {
      const osc  = ctx.createOscillator();
      const gNode = ctx.createGain();
      osc.connect(gNode);
      gNode.connect(ctx.destination);
      osc.type = 'sine';
      osc.frequency.value = freq;
      gNode.gain.setValueAtTime(0, ctx.currentTime + startTime);
      gNode.gain.linearRampToValueAtTime(gain, ctx.currentTime + startTime + 0.01);
      gNode.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + startTime + duration);
      osc.start(ctx.currentTime + startTime);
      osc.stop(ctx.currentTime + startTime + duration + 0.01);
    } catch { /* ignore */ }
  }

  function playAlarmChime() {
    if (muted) return;
    // Three ascending tones: E5, G#5, B5
    playTone(659, 0,    0.25, 0.45);
    playTone(830, 0.20, 0.25, 0.45);
    playTone(988, 0.40, 0.45, 0.50);
  }

  // ── Browser Notifications ──
  async function requestNotificationPermission() {
    if (!('Notification' in window)) return;
    if (Notification.permission === 'default') {
      await Notification.requestPermission().catch(() => {/* ignore */});
    }
  }

  function sendNotification() {
    if (!('Notification' in window) || Notification.permission !== 'granted' || notifSent) return;
    notifSent = true;
    try {
      new Notification('Timern är klar! ⏰', {
        body: 'Nedräkningen har nått noll.',
        icon: '/favicon.ico',
        tag: 'countdown-alarm',
      });
    } catch { /* ignore */ }
  }

  // ── Helpers ──
  function formatTime(ms: number): string {
    const totalSec = Math.ceil(Math.max(0, ms) / 1000);
    const h = Math.floor(totalSec / 3600);
    const m = Math.floor((totalSec % 3600) / 60);
    const s = totalSec % 60;
    const mm = String(m).padStart(2, '0');
    const ss = String(s).padStart(2, '0');
    if (h > 0) return `${h}:${mm}:${ss}`;
    return `${mm}:${ss}`;
  }

  function announce(msg: string) {
    if (!statusMsg) return;
    statusMsg.textContent = '';
    requestAnimationFrame(() => { statusMsg.textContent = msg; });
  }

  function getInputTotal(): number {
    const h = Math.max(0, parseInt((inputHours?.value  ?? '0'), 10) || 0);
    const m = Math.max(0, parseInt((inputMinutes?.value ?? '0'), 10) || 0);
    const s = Math.max(0, parseInt((inputSeconds?.value ?? '0'), 10) || 0);
    const total = h * 3600 + m * 60 + s;
    return Math.max(1, total);
  }

  function syncInputs(secs: number) {
    const h = Math.floor(secs / 3600);
    const m = Math.floor((secs % 3600) / 60);
    const s = secs % 60;
    if (inputHours)   inputHours.value   = String(h);
    if (inputMinutes) inputMinutes.value  = String(m);
    if (inputSeconds) inputSeconds.value  = String(s);
  }

  function updateDisplay(ms: number) {
    if (!timerTextEl) return;
    const text = formatTime(ms);
    timerTextEl.textContent = text;

    const totalSec = Math.ceil(ms / 1000);
    timerTextEl.classList.toggle('low-time', totalSec <= 30 && totalSec > 0);
    timerTextEl.classList.toggle('done',     totalSec === 0);

    if (running) {
      document.title = `${text} — Nedräkningstimer`;
    }
  }

  // ── Alarm ──
  function startAlarm() {
    alarmActive = true;
    if (alarmBanner) alarmBanner.hidden = false;
    timerDisplay?.classList.add('alarm');
    document.title = '⏰ Timern är klar!';
    playAlarmChime();
    alarmIntervalId = setInterval(playAlarmChime, 2500);
    announce('Timern är klar!');
    sendNotification();
  }

  function stopAlarm() {
    alarmActive = false;
    if (alarmBanner) alarmBanner.hidden = true;
    timerDisplay?.classList.remove('alarm');
    document.title = originalTitle;
    if (alarmIntervalId !== null) {
      clearInterval(alarmIntervalId);
      alarmIntervalId = null;
    }
  }

  // ── RAF loop ──
  function loop(ts: number) {
    if (!running) return;
    if (lastTs === null) { lastTs = ts; rafId = requestAnimationFrame(loop); return; }
    const elapsed = ts - lastTs;
    lastTs = ts;
    remainingMs -= elapsed;

    if (remainingMs <= 0) {
      remainingMs = 0;
      updateDisplay(0);
      stopLoop(false);
      startAlarm();
      return;
    }

    updateDisplay(remainingMs);
    rafId = requestAnimationFrame(loop);
  }

  function stopLoop(restoreTitle = true) {
    running = false;
    if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; }
    lastTs = null;
    if (startPauseBtn) startPauseBtn.textContent = 'Starta';
    if (restoreTitle) document.title = originalTitle;
  }

  // ── Timer controls ──
  function startTimer() {
    if (running || remainingMs <= 0) return;
    requestNotificationPermission();
    running = true;
    lastTs = null;
    if (startPauseBtn) startPauseBtn.textContent = 'Pausa';
    timeInputs?.classList.add('disabled');
    rafId = requestAnimationFrame(loop);
  }

  function pauseTimer() {
    stopLoop(true);
    timeInputs?.classList.remove('disabled');
  }

  function resetTimer() {
    stopLoop(true);
    stopAlarm();
    notifSent = false;
    remainingMs = getInputTotal() * 1000;
    timeInputs?.classList.remove('disabled');
    updateDisplay(remainingMs);
    announce('');
  }

  // ── Event listeners ──
  startPauseBtn?.addEventListener('click', () => {
    if (alarmActive) { stopAlarm(); resetTimer(); return; }
    running ? pauseTimer() : startTimer();
  });

  resetBtn?.addEventListener('click', resetTimer);

  dismissBtn?.addEventListener('click', () => {
    stopAlarm();
    resetTimer();
  });

  muteBtn?.addEventListener('click', () => {
    muted = !muted;
    if (iconSoundOn)  iconSoundOn.style.display  = muted ? 'none' : '';
    if (iconSoundOff) iconSoundOff.style.display = muted ? '' : 'none';
    muteBtn.setAttribute('aria-label', muted ? 'Ljud på' : 'Ljud av');
    muteBtn.title = muted ? 'Ljud på' : 'Ljud av';
    if (muted && alarmIntervalId !== null) {
      clearInterval(alarmIntervalId);
      alarmIntervalId = null;
    } else if (!muted && alarmActive) {
      alarmIntervalId = setInterval(playAlarmChime, 2500);
    }
  });

  presetBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      if (running) return;
      const secs = parseInt(btn.dataset.seconds ?? '0', 10);
      syncInputs(secs);
      remainingMs = secs * 1000;
      updateDisplay(remainingMs);
      presetBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    });
  });

  [inputHours, inputMinutes, inputSeconds].forEach(input => {
    input?.addEventListener('input', () => {
      if (running) return;
      remainingMs = getInputTotal() * 1000;
      updateDisplay(remainingMs);
      presetBtns.forEach(b => b.classList.remove('active'));
    });
  });

  document.addEventListener('keydown', (e: KeyboardEvent) => {
    const tag = (document.activeElement as HTMLElement)?.tagName;
    if (tag === 'INPUT' || tag === 'SELECT' || tag === 'TEXTAREA') return;
    if (e.code === 'Enter') {
      e.preventDefault();
      if (alarmActive) { stopAlarm(); resetTimer(); return; }
      running ? pauseTimer() : startTimer();
    } else if (e.code === 'Escape') {
      e.preventDefault();
      resetTimer();
    }
  });

  // Init — mark 5 min preset as active
  presetBtns.forEach(b => {
    b.classList.toggle('active', b.dataset.seconds === '300');
  });
  updateDisplay(remainingMs);
})();
</script>
