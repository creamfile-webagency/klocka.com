---
import Layout from '@/layouts/Layout.astro';

const sections = [
  {
    href: '/app/',
    label: 'Appar',
    desc: 'Sju gratis timers och tidappar — schackklocka, stoppur, Pomodoro och fler. Kör direkt i webbläsaren.',
    icon: '⏱',
  },
  {
    href: '/tid/',
    label: 'Tid i världen',
    desc: 'Lokal tid, tidszoner och sommartid för länder världen över. Planera möten och resor.',
    icon: '🌍',
  },
  {
    href: '/klockmarken/',
    label: 'Klockmärken',
    desc: 'Köpguider för Omega, Rolex, Breitling, Longines, TAG Heuer, Seiko, Casio och fler.',
    icon: '⌚',
  },
  {
    href: '/klockor/',
    label: 'Klockor',
    desc: 'Köpguider per kategori — herrur, damur, sportwatch och smartwatch.',
    icon: '💎',
  },
];

const tools = [
  { href: '/schackklocka/', label: 'Schackklocka', desc: 'Fischer & Bronstein tillägg', icon: '♟' },
  { href: '/stoppur/', label: 'Stoppur', desc: 'Tidtagning med varvtider', icon: '⏱' },
  { href: '/nedrakning/', label: 'Nedräkningstimer', desc: 'Räkna ner till noll', icon: '⏳' },
  { href: '/pomodoro/', label: 'Pomodoroklocka', desc: '25/5-tekniken för fokus', icon: '🍅' },
  { href: '/interval/', label: 'Intervallklocka', desc: 'Träning & intervalltimer', icon: '🔔' },
  { href: '/presentation/', label: 'Presentationsklocka', desc: 'Håll koll på din tid på scen', icon: '🎤' },
  { href: '/aggklocka/', label: 'Äggklocka', desc: 'Snabb köksTimer', icon: '🥚' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Klocka.com',
  url: 'https://klocka.com',
  description: 'Gratis tidverktyg och klockor online — schackklocka, stoppur, timer och mer',
  inLanguage: 'sv-SE',
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: 'https://klocka.com/?q={search_term_string}' },
    'query-input': 'required name=search_term_string',
  },
};
---

<Layout
  title="Klocka.com — Gratis timers, klockor och tid online"
  description="Gratis tidappar (schackklocka, stoppur, Pomodoro, timer), tid i världen, köpguider för klockmärken och köpguider per kategori. Allt samlat på Klocka.com."
  schema={schema}
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <h1>Allt om tid och klockor — på ett ställe</h1>
      <p class="hero-sub">
        Gratis tidappar, lokal tid världen över, köpguider för klockmärken och kategorier.
        Välj ett område nedan.
      </p>
    </div>
  </section>

  <!-- Main sections — primary navigation badges -->
  <section class="badges-section">
    <div class="section-inner">
      <ul class="badges-grid" role="list">
        {sections.map(({ href, label, desc, icon }) => (
          <li>
            <a href={href} class="badge-card">
              <span class="badge-icon" aria-hidden="true">{icon}</span>
              <span class="badge-body">
                <span class="badge-name">{label}</span>
                <span class="badge-desc">{desc}</span>
              </span>
              <svg class="badge-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M9 18l6-6-6-6"/>
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Tools grid -->
  <section class="tools-section">
    <div class="section-inner">
      <h2 class="section-heading">Populära appar</h2>
      <ul class="tools-grid" role="list">
        {tools.map(({ href, label, desc, icon }) => (
          <li>
            <a href={href} class="tool-card-link">
              <span class="tool-icon" aria-hidden="true">{icon}</span>
              <span class="tool-name">{label}</span>
              <span class="tool-desc">{desc}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="tools-footer-cta">
        <a href="/app/">Se alla appar →</a>
      </p>
    </div>
  </section>

  <!-- Pitch -->
  <section class="pitch-section">
    <div class="section-inner pitch-inner">
      <div class="pitch-block">
        <h2>Snabba, rena verktyg</h2>
        <p>Inget konto. Ingen app. Allt lagras lokalt i din webbläsare. Fungerar offline.</p>
      </div>
      <div class="pitch-block">
        <h2>Optimerade för mobil</h2>
        <p>Stora, pekfingervänliga ytor. Tangentbordsgenvägar för desktopmestare.</p>
      </div>
      <div class="pitch-block">
        <h2>Öppna för inbäddning</h2>
        <p>Alla verktyg kan snart bäddas in på din sajt — free with backlink.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    background: linear-gradient(135deg, var(--color-ink) 0%, color-mix(in srgb, var(--color-ink) 85%, var(--color-accent)) 100%);
    color: #fff;
    padding: var(--space-16) var(--space-4);
  }
  .hero-inner {
    max-width: var(--max-w-content);
    margin-inline: auto;
    text-align: center;
  }
  .hero h1 {
    font-size: clamp(var(--text-3xl), 5vw, 3.5rem);
    font-weight: 700;
    margin: 0 0 var(--space-4);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .hero-sub {
    font-size: var(--text-lg);
    color: color-mix(in srgb, #fff 75%, var(--color-ink));
    max-width: 40rem;
    margin-inline: auto;
    margin-bottom: 0;
  }

  .section-inner {
    max-width: var(--max-w-content);
    margin-inline: auto;
    padding: var(--space-12) var(--space-4);
  }
  .section-heading {
    font-size: var(--text-2xl);
    font-weight: 700;
    margin: 0 0 var(--space-8);
    letter-spacing: -0.01em;
  }

  /* Main badges — primary hub navigation */
  .badges-section {
    background: var(--color-surface);
  }
  .badges-section .section-inner {
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
  }
  .badges-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 640px) {
    .badges-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .badges-grid { grid-template-columns: repeat(4, 1fr); }
  }
  .badge-card {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-5);
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--color-ink);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
    height: 100%;
  }
  .badge-card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .badge-icon {
    font-size: var(--text-3xl);
    line-height: 1;
    flex-shrink: 0;
  }
  .badge-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }
  .badge-name {
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .badge-desc {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    line-height: 1.45;
  }
  .badge-arrow {
    flex-shrink: 0;
    color: var(--color-ink-muted);
    align-self: center;
  }

  .tools-footer-cta {
    margin: var(--space-8) 0 0;
    text-align: center;
  }
  .tools-footer-cta a {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 600;
    font-size: var(--text-base);
  }
  .tools-footer-cta a:hover { text-decoration: underline; }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tool-card-link {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--color-ink);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
    height: 100%;
  }
  .tool-card-link:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }
  .tool-icon { font-size: var(--text-3xl); line-height: 1; }
  .tool-name { font-size: var(--text-base); font-weight: 700; }
  .tool-desc { font-size: var(--text-sm); color: var(--color-ink-muted); }

  .pitch-section {
    background: var(--color-surface-2);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .pitch-inner {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-8);
  }
  .pitch-block h2 {
    font-size: var(--text-lg);
    font-weight: 700;
    margin: 0 0 var(--space-2);
  }
  .pitch-block p { font-size: var(--text-sm); color: var(--color-ink-muted); margin: 0; }
</style>
