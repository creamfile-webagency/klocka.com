---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="/" class="footer-logo">
        <svg width="20" height="20" viewBox="0 0 28 28" fill="none" aria-hidden="true">
          <circle cx="14" cy="14" r="12" stroke="currentColor" stroke-width="2.5"/>
          <line x1="14" y1="7" x2="14" y2="14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <line x1="14" y1="14" x2="19" y2="17" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <circle cx="14" cy="14" r="1.5" fill="currentColor"/>
        </svg>
        Klocka.com
      </a>
      <p class="footer-tagline">Gratis tidappar och klockor online</p>
    </div>

    <nav aria-label="Fotnavigation">
      <div class="footer-cols">
        <div class="footer-col">
          <div class="footer-col-heading">Appar</div>
          <ul role="list">
            <li><a href="/schackklocka/">Schackklocka</a></li>
            <li><a href="/stoppur/">Stoppur</a></li>
            <li><a href="/nedrakning/">Nedräkningstimer</a></li>
            <li><a href="/pomodoro/">Pomodoroklocka</a></li>
            <li><a href="/interval/">Intervallklocka</a></li>
            <li><a href="/presentation/">Presentationsklocka</a></li>
            <li><a href="/aggklocka/">Äggklocka</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <div class="footer-col-heading">Utforska</div>
          <ul role="list">
            <li><a href="/tid/">Tid i världen</a></li>
            <li><a href="/klockmarken/">Klockmärken</a></li>
            <li><a href="/klockor/">Klockor</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <div class="footer-col-heading">Om</div>
          <ul role="list">
            <li><a href="/om/">Om Klocka.com</a></li>
            <li><a href="/integritetspolicy/">Integritetspolicy</a></li>
            <li><a href="/redaktionell-policy/">Redaktionell policy</a></li>
            <li><a href="/sitemap.xml">Sitemap</a></li>
          </ul>
        </div>
      </div>
    </nav>
  </div>
  <div class="footer-bottom">
    <p>&copy; {year} Klocka.com — Alla appar är gratis och fungerar direkt i webbläsaren</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-ink);
    color: color-mix(in srgb, #fff 70%, var(--color-ink));
    margin-top: var(--space-16);
  }
  .footer-inner {
    max-width: var(--max-w-content);
    margin-inline: auto;
    padding: var(--space-12) var(--space-4) var(--space-8);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }
  @media (min-width: 640px) {
    .footer-inner { grid-template-columns: auto 1fr; }
  }

  .footer-brand { display: flex; flex-direction: column; gap: var(--space-2); }
  .footer-logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: #fff;
    font-weight: 700;
    font-size: var(--text-lg);
  }
  .footer-logo:hover { color: color-mix(in srgb, var(--color-accent) 80%, #fff); }
  .footer-tagline {
    font-size: var(--text-sm);
    color: color-mix(in srgb, #fff 55%, var(--color-ink));
    margin: 0;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: var(--space-6);
  }
  .footer-col-heading {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #fff;
    margin-bottom: var(--space-3);
  }
  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .footer-col a {
    color: color-mix(in srgb, #fff 65%, var(--color-ink));
    text-decoration: none;
    font-size: var(--text-sm);
    transition: color var(--transition-fast);
  }
  .footer-col a:hover { color: #fff; }

  .footer-bottom {
    border-top: 1px solid color-mix(in srgb, #fff 15%, var(--color-ink));
    padding: var(--space-4) var(--space-4);
    text-align: center;
  }
  .footer-bottom p {
    margin: 0;
    font-size: var(--text-xs);
    color: color-mix(in srgb, #fff 40%, var(--color-ink));
  }
</style>
