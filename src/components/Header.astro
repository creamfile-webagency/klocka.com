---
const navLinks = [
  { href: '/app/', label: 'Appar' },
  { href: '/tid/', label: 'Tid' },
  { href: '/klockmarken/', label: 'Klockmärken' },
  { href: '/klockor/', label: 'Klockor' },
  { href: '/om/', label: 'Om' },
];

const toolLinks = [
  { href: '/schackklocka/', label: 'Schackklocka' },
  { href: '/stoppur/', label: 'Stoppur' },
  { href: '/nedrakning/', label: 'Nedräkningstimer' },
  { href: '/pomodoro/', label: 'Pomodoroklocka' },
  { href: '/interval/', label: 'Intervaller' },
  { href: '/presentation/', label: 'Presentationsklocka' },
  { href: '/aggklocka/', label: 'Äggklocka' },
];

const { pathname } = Astro.url;
---

<header class="site-header" role="banner">
  <div class="header-inner">
    <a href="/" class="site-logo" aria-label="Klocka.com — startsida">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
        <circle cx="14" cy="14" r="12" stroke="currentColor" stroke-width="2.5"/>
        <line x1="14" y1="7" x2="14" y2="14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        <line x1="14" y1="14" x2="19" y2="17" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        <circle cx="14" cy="14" r="1.5" fill="currentColor"/>
      </svg>
      <span class="logo-text">Klocka<span class="logo-dot">.com</span></span>
    </a>

    <!-- Desktop nav -->
    <nav class="desktop-nav" aria-label="Primär navigation">
      <ul role="list">
        {navLinks.map(({ href, label }) => {
          const isTools = href === '/app/';
          const isActive = pathname === href || (isTools && pathname.match(/^\/(schackklocka|stoppur|nedrakning|pomodoro|interval|presentation|aggklocka)\//));
          return (
            <li class={isTools ? 'has-dropdown' : ''}>
              <a
                href={href}
                class:list={['nav-link', { active: isActive }]}
                aria-current={isActive ? 'page' : undefined}
              >
                {label}
                {isTools && (
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true" class="chevron">
                    <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                )}
              </a>
              {isTools && (
                <div class="dropdown" role="menu" aria-label="Appar">
                  {toolLinks.map(({ href: toolHref, label: toolLabel }) => (
                    <a
                      href={toolHref}
                      class:list={['dropdown-link', { active: pathname === toolHref }]}
                      role="menuitem"
                    >
                      {toolLabel}
                    </a>
                  ))}
                </div>
              )}
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Mobile hamburger -->
    <button
      id="menu-toggle"
      class="menu-toggle"
      aria-label="Öppna meny"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <svg id="icon-open" width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
        <path d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <svg id="icon-close" width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true" class="hidden">
        <path d="M4 4l14 14M18 4L4 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <!-- Mobile nav -->
  <nav id="mobile-nav" class="mobile-nav hidden" aria-label="Mobilmeny">
    <div class="mobile-nav-section">
      <div class="mobile-nav-heading">Appar</div>
      {toolLinks.map(({ href, label }) => (
        <a
          href={href}
          class:list={['mobile-nav-link', { active: pathname === href }]}
          aria-current={pathname === href ? 'page' : undefined}
        >{label}</a>
      ))}
    </div>
    <div class="mobile-nav-section">
      {navLinks.filter(l => l.href !== '/app/').map(({ href, label }) => (
        <a
          href={href}
          class:list={['mobile-nav-link', { active: pathname === href }]}
          aria-current={pathname === href ? 'page' : undefined}
        >{label}</a>
      ))}
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
  }
  .header-inner {
    max-width: var(--max-w-content);
    margin-inline: auto;
    padding-inline: var(--space-4);
    height: var(--nav-h);
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }
  .site-logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--color-ink);
    flex-shrink: 0;
    font-weight: 700;
    font-size: var(--text-lg);
  }
  .logo-text { letter-spacing: -0.02em; }
  .logo-dot  { color: var(--color-accent); }
  .site-logo:hover { color: var(--color-accent); }

  .desktop-nav {
    flex: 1;
    display: none;
  }
  @media (min-width: 768px) {
    .desktop-nav { display: block; }
  }
  .desktop-nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .desktop-nav li { position: relative; }
  .nav-link {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    color: var(--color-ink-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 500;
    transition: color var(--transition-fast), background var(--transition-fast);
    white-space: nowrap;
  }
  .nav-link:hover, .nav-link.active {
    color: var(--color-ink);
    background: var(--color-surface-2);
  }
  .nav-link.active { font-weight: 600; }
  .chevron { transition: transform var(--transition-fast); }

  /* Dropdown */
  .has-dropdown .dropdown {
    position: absolute;
    top: calc(100% + var(--space-1));
    left: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--space-2);
    min-width: 200px;
    display: none;
    z-index: 200;
  }
  .has-dropdown:hover .dropdown,
  .has-dropdown:focus-within .dropdown { display: block; }
  .has-dropdown:hover .chevron          { transform: rotate(180deg); }
  .dropdown-link {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--color-ink);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: background var(--transition-fast);
  }
  .dropdown-link:hover { background: var(--color-surface-2); }
  .dropdown-link.active { font-weight: 600; color: var(--color-accent); }

  /* Mobile toggle */
  .menu-toggle {
    display: flex;
    margin-left: auto;
    padding: var(--space-2);
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-ink);
    border-radius: var(--radius-md);
    min-height: 44px;
    min-width: 44px;
    align-items: center;
    justify-content: center;
  }
  .menu-toggle:hover { background: var(--color-surface-2); }
  @media (min-width: 768px) { .menu-toggle { display: none; } }

  /* Mobile nav */
  .mobile-nav {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    padding-bottom: var(--space-4);
  }
  .mobile-nav-section { padding: var(--space-4) var(--space-4) 0; }
  .mobile-nav-heading {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-muted);
    margin-bottom: var(--space-1);
    padding: var(--space-2) var(--space-3);
  }
  .mobile-nav-link {
    display: flex;
    align-items: center;
    padding: var(--space-3) var(--space-3);
    border-radius: var(--radius-md);
    color: var(--color-ink);
    text-decoration: none;
    font-size: var(--text-base);
    min-height: 44px;
    transition: background var(--transition-fast);
  }
  .mobile-nav-link:hover { background: var(--color-surface-2); }
  .mobile-nav-link.active { font-weight: 600; color: var(--color-accent); }
  .hidden { display: none !important; }
</style>

<script>
  const toggle = document.getElementById('menu-toggle') as HTMLButtonElement | null;
  const mobileNav = document.getElementById('mobile-nav');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !mobileNav?.classList.contains('hidden');
    mobileNav?.classList.toggle('hidden', isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
  });

  // Close mobile nav on outside click
  document.addEventListener('click', (e) => {
    if (!toggle?.contains(e.target as Node) && !mobileNav?.contains(e.target as Node)) {
      mobileNav?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    }
  });
</script>
