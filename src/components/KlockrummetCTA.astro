---
interface Props {
  brand: string;
  klockrummetUrl: string;
  ctaCopy: string;
  pageSectionUtm?: string;
  campaignSlug?: string;
}

const {
  brand,
  klockrummetUrl,
  ctaCopy,
  pageSectionUtm = 'buying-guide-cta',
  campaignSlug = 'bucket-b-brand',
} = Astro.props;

const utmHref =
  `${klockrummetUrl}?utm_source=klocka.com&utm_medium=cross-link` +
  `&utm_campaign=${campaignSlug}&utm_content=${pageSectionUtm}`;
---

<aside class="klockrummet-cta" aria-label={`Hitta ${brand} hos Klockrummet`}>
  <p class="klockrummet-cta__heading">Hitta {brand} hos Klockrummet</p>
  <p class="klockrummet-cta__body">Klockrummet är en av Sveriges ledande klockbutiker.</p>
  <a
    href={utmHref}
    class="btn btn-secondary klockrummet-cta__btn"
    target="_blank"
    rel="noopener"
    aria-label={`${ctaCopy} — öppnas i ny flik`}
  >
    {ctaCopy}
  </a>
  <p class="klockrummet-cta__caption">Via Klockrummet.se — vi samäger båda sajterna</p>
</aside>

<style>
  .klockrummet-cta {
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-6);
    max-width: var(--max-w-prose);
  }

  .klockrummet-cta__heading {
    font-size: var(--text-base);
    font-weight: 600;
    margin: 0 0 var(--space-2);
    color: var(--color-ink);
  }

  .klockrummet-cta__body {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-4);
  }

  .klockrummet-cta__btn {
    display: inline-flex;
  }

  .klockrummet-cta__caption {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    margin: var(--space-2) 0 0;
  }
</style>
