---
type Variant = 'budget' | 'present' | 'armband';

interface Props {
  variant: Variant;
  klockrummetUrl: string;
  ctaCopy: string;
  pageSectionUtm?: string;
  campaignSlug?: string;
  placement?: string;
}

const {
  variant,
  klockrummetUrl,
  ctaCopy,
  pageSectionUtm = 'buying-guide-cta',
  campaignSlug = 'bucket-b-brand',
  placement = 'buying-guide-cta',
} = Astro.props;

const variantContent: Record<Variant, { heading: string; body: string }> = {
  budget: {
    heading: 'Prisvärda klockor hos Klockrummet',
    body: 'Klockor för dam och herr i flera stilar – handla hos Klockrummet.',
  },
  present: {
    heading: 'Ge bort en klocka i present',
    body: 'Klockrummet har klockor för alla tillfällen — till student, jul, mors dag och mer.',
  },
  armband: {
    heading: 'Byt klockarmband',
    body: 'Klockrummet säljer armband i mesh, nato, läder och silikon.',
  },
};

const heading = variantContent[variant].heading;
const body = variantContent[variant].body;

const utmHref =
  `${klockrummetUrl}?utm_source=klocka.com&utm_medium=cross-link` +
  `&utm_campaign=${campaignSlug}&utm_content=${pageSectionUtm}`;
---

<aside class="klockrummet-cta" aria-label={heading}>
  <p class="klockrummet-cta__heading">{heading}</p>
  <p class="klockrummet-cta__body">{body}</p>
  <a
    href={utmHref}
    class="btn btn-secondary klockrummet-cta__btn"
    target="_blank"
    rel="noopener"
    aria-label={`${ctaCopy} — öppnas i ny flik`}
    data-placement={placement}
  >
    {ctaCopy}
  </a>
  <p class="klockrummet-cta__caption">Via Klockrummet.se — vi samäger båda sajterna</p>
</aside>

<style>
  .klockrummet-cta {
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-6);
    max-width: var(--max-w-prose);
  }

  .klockrummet-cta__heading {
    font-size: var(--text-base);
    font-weight: 600;
    margin: 0 0 var(--space-2);
    color: var(--color-ink);
  }

  .klockrummet-cta__body {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-4);
  }

  .klockrummet-cta__btn {
    display: inline-flex;
  }

  .klockrummet-cta__caption {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    margin: var(--space-2) 0 0;
  }
</style>

<script>
document.querySelectorAll('.klockrummet-cta__btn').forEach(btn => {
  btn.addEventListener('click', () => {
    if (typeof gtag !== 'undefined') {
      gtag('event', 'klockrummet_click', { placement: (btn as HTMLElement).dataset.placement });
    }
  });
});
</script>
